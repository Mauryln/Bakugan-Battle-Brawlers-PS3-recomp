+    }
+    if (s_wasapi_health.enabled) {
+        if (FAILED(padding_result) || FAILED(hr) || !buf) {
+            ++s_wasapi_health.failed_submit;
+        } else {
+            ULONGLONG now = GetTickCount64();
+            if (s_wasapi_health.last_submit_ms) {
+                ULONGLONG gap = now - s_wasapi_health.last_submit_ms;
+                if (gap > s_wasapi_health.max_gap_ms) s_wasapi_health.max_gap_ms = gap;
