+/* Reuse decoding only within one packet: arrays/constants can change before
+ * the next submission. Tags preserve correctness even for colliding indices. */
+static u32 vp_fetch_triangle_vertices(const rsx_state* state, u32 first, u32 count, VPSlot* out)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* value = getenv("VP_INDEX_CACHE");
+        enabled = !value || value[0] != '0';
+    }
+    if (count < 12 || !enabled) {
+        for (u32 k = 0; k < count; ++k)
+            read_vp_vertex(state, read_guest_index(state, first + k), &out[k * 16]);
+        return count;
+    }
+    u32 decoded = 0;
+    VPSlot cache[64][16];
+    u32 tags[64];
+    unsigned char valid[64] = {0};
+    for (u32 k = 0; k < count; ++k) {
+        u32 index = read_guest_index(state, first + k), slot = index & 63u;
+        if (!valid[slot] || tags[slot] != index) {
+            read_vp_vertex(state, index, cache[slot]);
+            ++decoded;
+            tags[slot] = index;
+            valid[slot] = 1;
+        }
+        memcpy(&out[k * 16], cache[slot], sizeof(cache[slot]));
+    }
+    return decoded;
+}
