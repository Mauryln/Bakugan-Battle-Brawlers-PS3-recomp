+static int audio_debug_enabled(void)
+{
+    static int s_dbg = -1;
+    if (s_dbg < 0) {
+        const char* e = getenv("AUDIO_DEBUG");
+        s_dbg = (e && e[0] && strcmp(e, "0") != 0) ? 1 : 0;
+    }
+    return s_dbg;
+}
+
+static unsigned long long audio_debug_ms(void)
+{
+#ifdef _WIN32
+    static ULONGLONG s_t0 = 0;
+    ULONGLONG now = GetTickCount64();
+    if (!s_t0) s_t0 = now;
+    return (unsigned long long)(now - s_t0);
+#else
+    return 0ull;
+#endif
+}
+
+static int audio_debug_slot_nonzero(const float* src, u32 samples)
+{
+    for (u32 i = 0; i < samples; ++i) {
+        uint32_t bits;
+        memcpy(&bits, src + i, sizeof(bits));
+        if (bits) return 1;
+    }
+    return 0;
+}
+
+static inline void audio_debug_check_sample(float v, int* nonzero, u32* nan_c,
+                                            u32* inf_c, u32* ext_c, float* max_abs)
+{
+    if (isnan(v)) {
+        ++(*nan_c);
+        *nonzero = 1;
+        return;
+    }
+    if (!isfinite(v)) {
+        ++(*inf_c);
+        *nonzero = 1;
+        return;
+    }
+    float av = fabsf(v);
+    if (av > 0.0f) *nonzero = 1;
+    if (av > *max_abs) *max_abs = av;
+    if (av > 4.0f) ++(*ext_c);
+}
