+static int fp_apply_packed_depth(char* hlsl, size_t capacity, u32 units, u32 cube_mask)
+{
+    if (!units) return 0;
+    static const char helper[] =
+        "float4 _rsx_unpack_zeta(float4 depth) {\n"
+        "    uint z = (uint)round(saturate(depth.x) * 16777215.0);\n"
+        "    return float4((z >> 16) & 255, (z >> 8) & 255, z & 255, 0) / 255.0;\n"
+        "}\n";
+    char prefix[6144];
+    memcpy(prefix, helper, sizeof helper);
+    size_t used = sizeof helper - 1;
+    for (u32 unit = 0; unit < RSX_MAX_TEXTURES; ++unit) {
+        if (!(units & (1u << unit))) continue;
+        static const char* const methods[] = {"Sample", "SampleBias", "SampleLevel"};
+        for (u32 mode = 0; mode < sizeof methods / sizeof methods[0]; ++mode) {
+            char sampler[48], call[48];
+            snprintf(sampler, sizeof sampler, cube_mask ? "rsx_tex%u.%s(" : "rsx_tex[%u].%s(", unit, methods[mode]);
+            if (!strstr(hlsl, sampler)) continue;
+            snprintf(call, sizeof call, "_rsx_zeta_sample_%u_%u(", unit, mode);
+            const char* args = mode ? "s, uv, lod" : "s, uv";
+            int written = snprintf(prefix + used, sizeof prefix - used,
+                "#define _rsx_zeta_sample_%u_%u(%s) _rsx_unpack_zeta(%s%s))\n",
+                unit, mode, args, sampler, args);
+            if (written < 0 || (size_t)written >= sizeof prefix - used) return -1;
+            used += (size_t)written;
+            hlsl_replace_all(hlsl, capacity, sampler, call);
+            if (strstr(hlsl, sampler)) return -1;
+        }
+    }
+    size_t length = strlen(hlsl) + 1;
+    if (length + used > capacity) return -1;
+    memmove(hlsl + used, hlsl, length);
+    memcpy(hlsl, prefix, used);
+    return 0;
+}
