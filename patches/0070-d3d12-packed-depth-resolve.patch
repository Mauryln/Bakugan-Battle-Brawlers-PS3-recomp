+typedef struct {
+    u32 src, dst, width, height, gen, tiles, ready_draw;
+} PackedDepthResolve;
+static PackedDepthResolve s_depth_resolves[4];
+static unsigned s_depth_resolve_count;
+
+static int draw_writes_zeta(const D3D12DrawRecord* draw)
+{
+    return draw->is_vp && draw->zeta_fmt == 2 &&
+        (draw->is_clear ? (draw->clear_mask & 1u) != 0 : (draw->depth_key & 3u) == 3u);
+}
+
+void rsx_d3d12_backend_depth_resolve_tile(u32 dst, u32 src, u32 width, u32 rows, u32 cols)
+{
+    for (u32 d = s_d3d.draw_count; d > 0; --d) {
+        const D3D12DrawRecord* draw = &s_d3d.draws[d - 1];
+        if (!draw_writes_zeta(draw) || !draw->zeta_off || draw->zeta_w != width ||
+            draw->zeta_h != rows || src < draw->zeta_off) continue;
+        u32 delta = src - draw->zeta_off;
+        u32 tile = delta / 4096u;
+        if (delta % 4096u || tile * 512u >= width || dst < delta / 2u) continue;
+        u32 base = dst - delta / 2u;
+        u32 remaining = width - tile * 512u;
+        if (!base || (base & 0xFFFFu) || cols != (remaining < 512u ? remaining : 512u))
+            continue;
+        PackedDepthResolve* resolve = NULL;
+        for (unsigned i = 0; i < s_depth_resolve_count; ++i)
+            if (s_depth_resolves[i].dst == base) { resolve = &s_depth_resolves[i]; break; }
+        if (!resolve) {
+            if (s_depth_resolve_count >= sizeof s_depth_resolves / sizeof s_depth_resolves[0]) return;
+            resolve = &s_depth_resolves[s_depth_resolve_count++];
+            memset(resolve, 0, sizeof *resolve);
+        }
+        if (resolve->src != draw->zeta_off || resolve->width != width ||
+            resolve->height != rows || resolve->ready_draw != s_d3d.draw_count)
+            resolve->tiles = 0;
+        resolve->dst = base;
+        resolve->src = draw->zeta_off;
+        resolve->width = width;
+        resolve->height = rows;
+        resolve->ready_draw = s_d3d.draw_count;
+        resolve->tiles |= 1u << tile;
+        resolve->gen = g_guest_gen;
+        return;
+    }
+}
+
+static const PackedDepthResolve* find_packed_resolve(u32 off, u32 w, u32 h, u32 draw_index)
+{
+    for (unsigned i = 0; i < s_depth_resolve_count; ++i) {
+        const PackedDepthResolve* r = &s_depth_resolves[i];
+        if (r->dst == off && r->width == w && r->height == h && r->ready_draw <= draw_index &&
+            r->tiles == ((1u << ((w + 511u) / 512u)) - 1u)) return r;
+    }
+    return NULL;
+}
+
+static int packed_depth_range_unchanged(u32 address, u32 width, u32 height, u32 gen)
+{
+    const u64 end = (u64)address + (u64)width * height * 4u;
+    if (!address || !width || !height || end > 0x100000000ull) return 0;
+    for (u32 p = address >> 12; p <= (end - 1u) >> 12; ++p)
+        if (g_guest_page_gen[p] > gen) return 0;
+    return 1;
 }
 
