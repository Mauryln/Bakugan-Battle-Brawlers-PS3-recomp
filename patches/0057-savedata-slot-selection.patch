+/* ---------------------------------------------------------------------------
+ * Delete entry points
+ * -----------------------------------------------------------------------*/
+
+static int remove_dir_recursive(const char* path)
+{
+#ifdef _WIN32
+    char search[1024];
+    snprintf(search, sizeof(search), "%s\\*", path);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h != INVALID_HANDLE_VALUE) {
+        do {
+            if (!strcmp(fd.cFileName, ".") || !strcmp(fd.cFileName, "..")) continue;
+            char child[1024];
+            snprintf(child, sizeof(child), "%s\\%s", path, fd.cFileName);
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+                remove_dir_recursive(child);
+            else
+                DeleteFileA(child);
+        } while (FindNextFileA(h, &fd));
+        FindClose(h);
+    }
+    return RemoveDirectoryA(path) ? 0 : -1;
+#else
+    DIR* dp = opendir(path);
+    if (dp) {
+        struct dirent* de;
+        while ((de = readdir(dp)) != NULL) {
+            if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+            char child[1024];
+            snprintf(child, sizeof(child), "%s/%s", path, de->d_name);
+            HOST_STAT_T st;
+            if (HOST_STAT(child, &st) == 0 && S_ISDIR(st.st_mode))
+                remove_dir_recursive(child);
+            else
+                remove(child);
+        }
+        closedir(dp);
+    }
+    return rmdir(path);
+#endif
+}
+
+static s32 dispatch_func_done(uint32_t func_opd, s32 exc, const char* dirName,
+                              u32 sizeKB, uint32_t userdata_ea)
+{
+    if (!g_ps3_guest_caller || !func_opd) return CELL_SAVEDATA_CBRESULT_ERR_FAILURE;
+    scratch_reset();
+    uint32_t cb = scratch_alloc(SAVEDATA_CBRESULT_SIZE);
+    uint32_t get = scratch_alloc(112); /* DoneGet: exc+0, dirName+4, sizeKB+36, hdd+40, res[64] */
+    if (!cb || !get) return CELL_SAVEDATA_CBRESULT_ERR_FAILURE;
+    marshal_cbresult_init(cb, CELL_SAVEDATA_CBRESULT_OK_NEXT, userdata_ea);
+    vm_write32(get + 0, (u32)exc);
+    if (dirName) {
+        size_t len = strnlen(dirName, CELL_SAVEDATA_DIRNAME_SIZE - 1);
+        memcpy(vm_base + get + 4, dirName, len);
+        ((char*)vm_base)[get + 4 + len] = 0;
+    }
+    vm_write32(get + 36, sizeKB);
+    vm_write32(get + 40, 1024 * 1024);
+    g_ps3_guest_caller(func_opd, cb, get, 0, 0, 0, 0, 0, 0);
+    return marshal_cbresult_read_result(cb);
+}
+
+/* Dispatch a Fixed/List selection callback and copy the directory it picked
+ * out of the guest FixedSet. Returns the callback result, or a negative
+ * CBRESULT on failure; `directory` is empty when nothing usable was chosen. */
+static s32 savedata_select_fixed_dir(CellSaveDataSetList* setList,
+                                     CellSaveDataSetBuf* setBuf,
+                                     CellSaveDataFixedCallback funcFixed,
+                                     uint32_t userdata_ea,
+                                     CellSaveDataDirList** out_dirs,
+                                     u32* out_count,
+                                     char directory[CELL_SAVEDATA_DIRNAME_SIZE])
+{
+    directory[0] = 0;
+    u32 dir_max = vm_read32((u32)(uintptr_t)setBuf);
+    if (dir_max > CELL_SAVEDATA_DIRLIST_MAX) return CELL_SAVEDATA_ERROR_PARAM;
+    CellSaveDataDirList* dirs = dir_max ? calloc(dir_max, sizeof(*dirs)) : NULL;
+    if (dir_max && !dirs) return CELL_SAVEDATA_ERROR_INTERNAL;
+    u32 prefix = vm_read32((u32)(uintptr_t)setList + 8);
+    u32 count = enumerate_save_dirs(prefix ? (char*)vm_base + prefix : "", dirs, NULL, dir_max,
+                                    vm_read32((u32)(uintptr_t)setList + 0),
+                                    vm_read32((u32)(uintptr_t)setList + 4));
+    u32 listed = count < dir_max ? count : dir_max;
+
+    scratch_reset();
+    u32 cb = scratch_alloc(SAVEDATA_CBRESULT_SIZE);
+    u32 get = scratch_alloc(0x4C);
+    u32 set = scratch_alloc(12);
+    u32 list = listed ? scratch_alloc(listed * 48) : 0;
+    if (!cb || !get || !set || (listed && !list)) { free(dirs); return CELL_SAVEDATA_ERROR_INTERNAL; }
+    marshal_cbresult_init(cb, CELL_SAVEDATA_CBRESULT_OK_NEXT, userdata_ea);
+    vm_write32(get, count); vm_write32(get + 4, listed); vm_write32(get + 8, list);
+    if (listed) memcpy(vm_base + list, dirs, listed * 48);
+    g_ps3_guest_caller((u32)(uintptr_t)funcFixed, cb, get, set, 0, 0, 0, 0, 0);
+    s32 result = marshal_cbresult_read_result(cb);
+
+    if (result == CELL_SAVEDATA_CBRESULT_OK_NEXT) {
+        u32 selected = vm_read32(set);
+        const char* name = selected ? (const char*)vm_base + selected : NULL;
+        size_t len = name ? strnlen(name, CELL_SAVEDATA_DIRNAME_SIZE) : 0;
+        if (len && len < CELL_SAVEDATA_DIRNAME_SIZE &&
+            !strchr(name, '/') && !strchr(name, '\\') &&
+            strcmp(name, ".") != 0 && strcmp(name, "..") != 0)
+            memcpy(directory, name, len + 1);
+        else
+            result = CELL_SAVEDATA_CBRESULT_ERR_NODATA;
+    }
+    if (out_dirs) *out_dirs = dirs; else free(dirs);
+    if (out_count) *out_count = count;
+    return result;
+}
+
+static s32 savedata_delete_one(const char* directory, uint32_t funcDone, uint32_t userdata_ea)
+{
+    char path[1024];
+    build_save_path(path, sizeof path, directory);
+    u32 size = savedata_dir_size_kb(path);
+    int rc = remove_dir_recursive(path);
+    printf("[cellSaveData] delete dir='%s' -> %d%c", directory, rc, 10);
+    s32 exc = rc == 0 ? CELL_OK : CELL_SAVEDATA_ERROR_NODATA;
+    s32 done = dispatch_func_done(funcDone, exc, directory, size, userdata_ea);
+    if (done < 0) return CELL_SAVEDATA_ERROR_CBRESULT;
+    return exc;
+}
+
+s32 cellSaveDataFixedDelete(CellSaveDataSetList* setList, CellSaveDataSetBuf* setBuf,
+                            CellSaveDataFixedCallback funcFixed,
+                            CellSaveDataDoneCallback funcDone,
+                            u32 container, void* userdata)
+{
+    (void)container;
+    printf("[cellSaveData] FixedDelete()\n");
+    if (!setList || !setBuf || !funcFixed || !funcDone || !g_ps3_guest_caller)
+        return CELL_SAVEDATA_ERROR_PARAM;
+
+    char directory[CELL_SAVEDATA_DIRNAME_SIZE];
+    CellSaveDataDirList* dirs = NULL;
+    u32 count = 0;
+    s32 result = savedata_select_fixed_dir(setList, setBuf, funcFixed,
+                                           (uint32_t)(uintptr_t)userdata,
+                                           &dirs, &count, directory);
+    free(dirs);
+    if (result < 0) return CELL_SAVEDATA_ERROR_CBRESULT;
+    if (!directory[0]) return CELL_SAVEDATA_ERROR_NODATA;
+    return savedata_delete_one(directory, (uint32_t)(uintptr_t)funcDone,
+                               (uint32_t)(uintptr_t)userdata);
+}
+
+s32 cellSaveDataListDelete(CellSaveDataSetList* setList, CellSaveDataSetBuf* setBuf,
+                           CellSaveDataListCallback funcList,
+                           CellSaveDataDoneCallback funcDone,
+                           u32 container, void* userdata)
+{
+    (void)container;
+    printf("[cellSaveData] ListDelete()\n");
+    if (!setList || !setBuf || !funcList || !funcDone || !g_ps3_guest_caller)
+        return CELL_SAVEDATA_ERROR_PARAM;
+
+    u32 dir_max = vm_read32((u32)(uintptr_t)setBuf + 0);
+    if (dir_max == 0) dir_max = CELL_SAVEDATA_DIRLIST_MAX;
+    CellSaveDataDirList* dirList = (CellSaveDataDirList*)calloc(dir_max, sizeof(CellSaveDataDirList));
+    CellSaveDataSlotInfo* slots = (CellSaveDataSlotInfo*)calloc(dir_max, sizeof(CellSaveDataSlotInfo));
+    if (!dirList || !slots) { free(dirList); free(slots); return CELL_SAVEDATA_ERROR_INTERNAL; }
+
+    u32 prefix = vm_read32((u32)(uintptr_t)setList + 8);
+    u32 count = enumerate_save_dirs(prefix ? (char*)vm_base + prefix : "", dirList, slots, dir_max,
+                                    vm_read32((u32)(uintptr_t)setList + 0),
+                                    vm_read32((u32)(uintptr_t)setList + 4));
+    u32 listed = count < dir_max ? count : dir_max;
+
+    char directory[CELL_SAVEDATA_DIRNAME_SIZE];
+    s32 result = dispatch_func_select((uint32_t)(uintptr_t)funcList, dirList, slots, listed,
+                                      (uint32_t)(uintptr_t)setBuf, 0,
+                                      (uint32_t)(uintptr_t)userdata, "funcList", directory);
+    free(dirList);
+    free(slots);
+    if (result < 0) return CELL_SAVEDATA_ERROR_CBRESULT;
+    if (!directory[0]) return CELL_SAVEDATA_ERROR_NODATA;
+    return savedata_delete_one(directory, (uint32_t)(uintptr_t)funcDone,
+                               (uint32_t)(uintptr_t)userdata);
+}
