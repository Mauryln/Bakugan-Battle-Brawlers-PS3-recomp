  * `selected` receives the chosen directory ("" when none): the first listed
  * entry, else the new-save name, else the focus name. For a save with nothing
  * listed the new-save name wins -- headless, there is no user to pick. */
+static void savedata_guest_str(uint32_t ea, char* out, size_t n)
+{
+    size_t i;
+    out[0] = 0;
+    if (!ea) return;
+    for (i = 0; i + 1 < n; i++) {
+        out[i] = (char)vm_read8(ea + (uint32_t)i);
+        if (!out[i]) return;
+    }
+    out[n - 1] = 0;
+}
+
+/* Automation override: PS3_SAVEDATA_CHOICE=new|first|last|<index>|<dir>|cancel.
+ * Returns 1 when it picked, 0 to cancel, -1 when the variable is not set. */
+static int savedata_env_choice(const CellSaveDataSlotInfo* slots, int count,
+                               const char* new_name, char* out, size_t n)
+{
+    const char* env = getenv("PS3_SAVEDATA_CHOICE");
+    if (!env || !*env) return -1;
+    if (!strcmp(env, "cancel")) return 0;
+    if (!strcmp(env, "new")) {
+        if (!new_name || !*new_name) return 0;
+        snprintf(out, n, "%s", new_name);
+        return 1;
+    }
+    int idx = -2;
+    if (!strcmp(env, "first")) {
+        idx = 0;
+    } else if (!strcmp(env, "last")) {
+        idx = count - 1;
+    } else {
+        char* end = NULL;
+        long v = strtol(env, &end, 10);
+        if (end && *end == '\0') idx = (int)v;
+    }
+    if (idx != -2) {
+        if (idx < 0 || idx >= count) return 0;
+        snprintf(out, n, "%s", slots[idx].dirName);
+        return 1;
+    }
+    snprintf(out, n, "%s", env);
+    return 1;
+}
+
+static int savedata_choose(const CellSaveDataSlotInfo* slots, int count, int focus,
+                           int is_save, const char* new_name, char* out, size_t n)
+{
+    int r = savedata_env_choice(slots, count, new_name, out, n);
+    if (r >= 0) return r;
+    if (s_chooser) return s_chooser(is_save, slots, count, focus, new_name, out, n);
+    return -1;
+}
