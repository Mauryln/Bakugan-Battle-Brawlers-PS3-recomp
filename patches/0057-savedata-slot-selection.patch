+/* setList.dirNamePrefix may hold several alternatives separated by '|'. */
+static int savedata_dir_matches(const char* name, const char* prefix)
+{
+    if (!prefix || !prefix[0]) return 1;
+    const char* seg = prefix;
+    for (;;) {
+        const char* bar = strchr(seg, '|');
+        size_t n = bar ? (size_t)(bar - seg) : strlen(seg);
+        if ((!n || strncmp(name, seg, n) == 0) && n) return 1;
+        if (!bar) break;
+        seg = bar + 1;
+    }
+    return 0;
+}
