+/* Next free numbered sibling of an existing "-NN" save. This is the fallback
+ * for the FixedSave2 menu: every manual save gets its own directory instead of
+ * overwriting the one the title names. */
+static int savedata_next_slot(const char* dir, char* out, size_t n)
+{
+    size_t len = strlen(dir);
+    if (len < 3 || len - 2 >= CELL_SAVEDATA_DIRNAME_SIZE - 4) return 0;
+    if (dir[len - 3] != '-' ||
+        dir[len - 2] < '0' || dir[len - 2] > '9' ||
+        dir[len - 1] < '0' || dir[len - 1] > '9') return 0;
+
+    char base[CELL_SAVEDATA_DIRNAME_SIZE];
+    memcpy(base, dir, len - 2);
+    base[len - 2] = 0;
+
+    for (int i = 0; i < 100; i++) {
+        char cand[CELL_SAVEDATA_DIRNAME_SIZE], path[1024];
+        snprintf(cand, sizeof cand, "%s%02d", base, i);
+        build_save_path(path, sizeof path, cand);
+        if (!dir_has_save(path)) {
+            snprintf(out, n, "%s", cand);
+            return 1;
+        }
+    }
+    return 0;
+}
