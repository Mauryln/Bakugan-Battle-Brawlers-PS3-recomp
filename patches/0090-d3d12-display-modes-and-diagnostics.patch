+static void update_fullscreen_state(void)
+{
+    HWND hwnd = s_d3d.hwnd;
+    if (s_d3d.fullscreen_on_activation && GetForegroundWindow() == hwnd && !IsIconic(hwnd)) {
+        s_d3d.fullscreen_on_activation = 0;
+        if (s_d3d.custom_swapchain && s_swapchain_provider.prepare_resize)
+            s_swapchain_provider.prepare_resize(s_d3d.swap_chain);
+        /* The HWND already covers the intended monitor. Let DXGI select the
+         * output compatible with the swap chain's adapter. */
+        HRESULT hr = s_d3d.swap_chain->lpVtbl->SetFullscreenState(s_d3d.swap_chain, TRUE, NULL);
+        if (hr == S_OK) {
+            s_display_mode = DISPLAY_FULLSCREEN;
+            s_d3d.resize_forced = 1;
+            s_d3d.resize_pending = 1;
+            fprintf(stderr, "[WINDOW] mode=fullscreen (DXGI)\n");
+        } else {
+            fprintf(stderr, "[WINDOW] DXGI fullscreen unavailable (0x%08lX); using borderless\n", hr);
+            fill_monitor(hwnd);
+        }
+    } else if (s_display_mode == DISPLAY_FULLSCREEN && s_d3d.resize_pending) {
+        BOOL fullscreen = TRUE;
+        if (SUCCEEDED(s_d3d.swap_chain->lpVtbl->GetFullscreenState(s_d3d.swap_chain, &fullscreen, NULL)) &&
+            !fullscreen) {
+            s_display_mode = DISPLAY_BORDERLESS;
+            s_d3d.resize_forced = 1;
+            if (!IsIconic(hwnd)) fill_monitor(hwnd);
+        }
     }
 }
 
