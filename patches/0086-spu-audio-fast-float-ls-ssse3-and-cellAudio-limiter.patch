diff --git a/runtime/spu/spu_helpers.h b/runtime/spu/spu_helpers.h
index b742181..5e96b44 100644
--- a/runtime/spu/spu_helpers.h
+++ b/runtime/spu/spu_helpers.h
@@ -1055,6 +1055,26 @@ SPU__NV_INLINE u128 spu__nv_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t
 SPU__NV_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__nv_fma(a, b, c, 0, 0); }            /* a*b + c */
 SPU__NV_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__nv_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
 SPU__NV_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__nv_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
+#elif defined(SPU_FAST_FLOAT) && (defined(__SSE2__) || defined(_M_X64)) && !defined(SPU_SCALAR_HELPERS)
+#include <emmintrin.h>
+/* Audio DSP TUs (audio_pcm / audio_mix / MultiStream) run plain single-precision
+ * filters and mixers well inside [-10, +10], where IEEE-754 SSE (with FTZ+DAZ)
+ * differs from SPU truncation by <= 0.5 ULP (-140 dB) and avoids the ~12x cost
+ * of software/AVX2-double Dekker truncation on every FMA. */
+static inline __m128 spu__ff_ldps(u128 a) {
+    return _mm_castsi128_ps(_mm_loadu_si128((const __m128i*)a._u32));
+}
+static inline u128 spu__ff_stps(__m128 v) {
+    u128 r;
+    _mm_storeu_si128((__m128i*)r._u32, _mm_castps_si128(v));
+    return r;
+}
+static inline u128 spu_fa(u128 a, u128 b) { return spu__ff_stps(_mm_add_ps(spu__ff_ldps(a), spu__ff_ldps(b))); }
+static inline u128 spu_fs(u128 a, u128 b) { return spu__ff_stps(_mm_sub_ps(spu__ff_ldps(a), spu__ff_ldps(b))); }
+static inline u128 spu_fm(u128 a, u128 b) { return spu__ff_stps(_mm_mul_ps(spu__ff_ldps(a), spu__ff_ldps(b))); }
+static inline u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__ff_stps(_mm_add_ps(_mm_mul_ps(spu__ff_ldps(a), spu__ff_ldps(b)), spu__ff_ldps(c))); }
+static inline u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__ff_stps(_mm_sub_ps(_mm_mul_ps(spu__ff_ldps(a), spu__ff_ldps(b)), spu__ff_ldps(c))); }
+static inline u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__ff_stps(_mm_sub_ps(spu__ff_ldps(c), _mm_mul_ps(spu__ff_ldps(a), spu__ff_ldps(b)))); }
 #elif defined(__AVX2__) && !defined(SPU_SCALAR_HELPERS)
 /* The NEON fast path above, on x86 with AVX2: the four lanes widened to one f64x4 (exact),
  * the operation, the 29 low significand bits cleared, narrowed (exact). Same lane rules: an
@@ -1251,7 +1271,17 @@ static inline u128 spu_cflts(u128 a, int i8) {
     return r;
 }
 static inline u128 spu_cfltu(u128 a, int i8) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = spu__cfl_lane(a._u32[i], 173 - (i8 & 0xFF), 1); return r; }
-static inline u128 spu_csflt(u128 a, int i8) { u128 r; for (int i = 0; i < 4; i++) { const int32_t v = a._s32[i];
+static inline u128 spu_csflt(u128 a, int i8) {
+#if defined(SPU_FAST_FLOAT) && (defined(__SSE2__) || defined(_M_X64)) && !defined(SPU_SCALAR_HELPERS)
+    if ((i8 & 0xFF) == 155) {
+        u128 out;
+        __m128i vi = _mm_loadu_si128((const __m128i*)a._u32);
+        __m128  vf = _mm_cvtepi32_ps(vi);
+        _mm_storeu_si128((__m128i*)out._u32, _mm_castps_si128(vf));
+        return out;
+    }
+#endif
+    u128 r; for (int i = 0; i < 4; i++) { const int32_t v = a._s32[i];
     r._u32[i] = v ? spu__sf_pack(v < 0 ? 0x80000000u : 0, v < 0 ? 0u - (uint32_t)v : (uint32_t)v, -(155 - (i8 & 0xFF))) : 0; } return r; }
 static inline u128 spu_cuflt(u128 a, int i8) { u128 r; for (int i = 0; i < 4; i++) { const uint32_t v = a._u32[i];
     r._u32[i] = v ? spu__sf_pack(0, v, -(155 - (i8 & 0xFF))) : 0; } return r; }
