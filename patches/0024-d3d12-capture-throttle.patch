+                if (now_ms - last_cap_ms >= 500) {
+                    last_cap_ms = now_ms;
+                    rsx_capture_frame(fi, s_dbg_last_draws, capture_index++);
+                } else {
+                    fprintf(stderr, "[RSXCAP] trigger dropped (throttle 500ms)%c", 10);
+                }
             }
         }
     }
