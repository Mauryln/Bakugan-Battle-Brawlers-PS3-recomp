+static u32 vp_vertex_stride(u32 mask)
+{
+    u32 attributes = 0;
+    for (u32 i = 0; i < 16; ++i) attributes += (mask >> i) & 1u;
+    return attributes ? attributes * 16u : 16u;
+}
+
 static void vp_flush_vertex_frame(void* upload, const void* cpu, u32 capacity, u32 parity, u32 bytes)
 {
     if (!bytes) return;
     u64 offset = (u64)parity * capacity * 256u;
     memcpy((char*)upload + offset, (const char*)cpu + offset, bytes);
 }
+
+static void vp_pack_vertex_stream(void* dst, const void* src, u32 count, u32 mask)
+{
+    if (mask == 0xFFFFu) { vp_flush_vertex_frame(dst, src, 0, 0, count * 256u); return; }
+    if (!mask) { memset(dst, 0, (size_t)count * 16u); return; }
+    u32 attributes[16], used = 0;
+    for (u32 i = 0; i < 16; ++i) if (mask & (1u << i)) attributes[used++] = i;
+    u8* out = (u8*)dst;
+    const u8* input = (const u8*)src;
+    for (u32 v = 0; v < count; ++v)
+        for (u32 a = 0; a < used; ++a) {
+            memcpy(out, input + (size_t)v * 256u + attributes[a] * 16u, 16u);
+            out += 16u;
+        }
+}
+
+static u32 vp_compact_input_layout(u32 mask, D3D12_INPUT_ELEMENT_DESC* layout)
+{
+    u32 count = 0;
+    for (u32 i = 0; i < 16; ++i) {
+        if (!(mask & (1u << i))) continue;
+        D3D12_INPUT_ELEMENT_DESC* entry = &layout[count];
+        memset(entry, 0, sizeof(*entry));
+        entry->SemanticName = "ATTR";
+        entry->SemanticIndex = i;
+        entry->Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+        entry->AlignedByteOffset = count * 16u;
+        entry->InputSlotClass = D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA;
+        ++count;
+    }
+    return count;
+}
