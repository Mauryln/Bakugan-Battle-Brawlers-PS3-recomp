+/* Called after the previous GPU fence and PSO preparation. CPU snapshots keep
+ * their canonical 16-slot format; only bytes consumed by each selected VS are
+ * uploaded. Fallback pipelines retain the complete layout. */
+static int vp_upload_compact_frame(void)
+{
+    u32 bytes = 0;
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        D3D12DrawRecord* dr = &s_d3d.draws[i];
+        if (!dr->is_vp || dr->is_clear) continue;
+        u32 mask = s_frame_psos[i] && dr->vs_idx >= 0 && dr->vs_idx < s_d3d.vp_vs_n
+            ? s_d3d.vp_vs[dr->vs_idx].input_mask : 0xFFFFu;
+        dr->gpu_input_mask = mask;
+        dr->gpu_stride = vp_vertex_stride(mask);
+        dr->gpu_byte_offset = bytes;
+        bytes += dr->vertex_count * dr->gpu_stride;
+    }
+    if (bytes > s_d3d.vp_gpu_capacity) {
+        u32 capacity = s_d3d.vp_gpu_capacity;
+        while (capacity < bytes) capacity *= 2u;
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = (u64)capacity * 2u;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ID3D12Resource* resource = NULL; void* mapped = NULL;
+        D3D12_RANGE empty = {0,0};
+        HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+            D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+            &IID_ID3D12Resource, (void**)&resource);
+        if (SUCCEEDED(hr)) hr = resource->lpVtbl->Map(resource, 0, &empty, &mapped);
+        if (FAILED(hr) || !mapped) {
+            if (resource) resource->lpVtbl->Release(resource);
+            fprintf(stderr, "[VPVB] GPU allocation failed (%u bytes/frame, hr=%08X)\n",
+                capacity, (unsigned)hr);
+            return 0;
+        }
+        s_d3d.vp_vb->lpVtbl->Unmap(s_d3d.vp_vb, 0, NULL);
+        s_d3d.vp_vb->lpVtbl->Release(s_d3d.vp_vb);
+        s_d3d.vp_vb = resource; s_d3d.vp_vb_upload = mapped;
+        s_d3d.vp_gpu_capacity = capacity;
+        fprintf(stderr, "[VPVB] GPU upload grew to %u bytes per frame\n", capacity);
+    }
+    for (u32 i = 0; i < s_d3d.draw_count && i < MAX_DRAWS; ++i) {
+        D3D12DrawRecord* dr = &s_d3d.draws[i];
+        if (!dr->is_vp || dr->is_clear) continue;
+        u32 mask = dr->gpu_input_mask;
+        vp_pack_vertex_stream((char*)s_d3d.vp_vb_upload +
+            (u64)s_d3d.vp_parity * s_d3d.vp_gpu_capacity + dr->gpu_byte_offset,
+            (char*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity *
+            s_d3d.vp_vertex_capacity * 256u + dr->vb_byte_offset, dr->vertex_count, mask);
+    }
+    if (perf_on()) {
+        static u32 frames = 0;
+        if (++frames % 120u == 0)
+            fprintf(stderr, "[PERF vertex] canonical=%u upload=%u GPU-capacity=%u bytes/frame\n",
+                s_d3d.vp_vb_offset, bytes, s_d3d.vp_gpu_capacity);
+    }
+    return 1;
+}
