  * Returns 0 on success, -1 on failure. */
 int rsx_d3d12_backend_init(u32 width, u32 height, const char* title);
 
+/* Optional host output pass, registered before backend init. Guest render
+ * dimensions stay unchanged. Resources enter/leave record in COMMON state;
+ * record owns its descriptors and records on the supplied direct command list.
+ * Return 0 on success. All callbacks run on the render thread. */
+typedef struct rsx_d3d12_output_pass {
+    u32 width, height;
+    void* userdata;
+    int (*initialize)(void* userdata, void* device, void* queue, u32 input_width, u32 input_height);
+    int (*record)(void* userdata, void* command_list, void* input, void* output, u32 frame_index);
+    void (*shutdown)(void* userdata);
+} rsx_d3d12_output_pass;
+int rsx_d3d12_backend_set_output_pass(const rsx_d3d12_output_pass* pass);
+
 /* Shut down the D3D12 backend and release all resources. */
 void rsx_d3d12_backend_shutdown(void);
 
