+
+int rsx_d3d12_backend_set_output_pass(const rsx_d3d12_output_pass* pass)
+{
+    if (s_d3d.device) return -1;
+    if (!pass) { memset(&s_output_pass, 0, sizeof(s_output_pass)); return 0; }
+    if (!pass->initialize || !pass->record || !pass->shutdown ||
+        !pass->width || !pass->height || pass->width > 8192 || pass->height > 8192)
+        return -1;
+    s_output_pass = *pass;
+    return 0;
+}
 
