+/* Depth-compare (shadow) units for a draw: fill `shadow` descriptors from the
+ * bound textures and return the mask of units whose comparison layout the
+ * decompiler supports. Any sampled depth texture with an unsupported layout
+ * (float depth, cube, mips, out-of-range compare func) clears the mask so the
+ * draw falls back to the ordinary sample path it used before this support. */
+static u32 dr_shadow_mask(const D3D12DrawRecord* dr, rsx_fp_shadow_desc shadow[16])
+{
+    memset(shadow, 0, 16 * sizeof *shadow);
+    /* The shadow helper only emits the 2D t-array spelling; a program mixing a
+     * cube unit with a depth-compare unit would mis-declare its sampler, so
+     * disable comparison for that draw rather than risk a bad compile. */
+    if (dr_cube_mask(dr)) return 0;
+    u32 mask = 0;
+    for (int u = 0; u < RSX_MAX_TEXTURES; u++) {
+        if (!(dr->sampled_units & (1u << u)) || !dr->tex[u].set) continue;
+        rsx_fp_shadow_desc_from_texture(&shadow[u], dr->tex[u].fmt, 2,
+            (u32)dr->tex[u].cube, dr->tex[u].mips, dr->tex[u].filter,
+            dr->tex[u].address, dr->tex[u].control0);
+        if (shadow[u].enabled == 1) mask |= 1u << u;
+        else if (shadow[u].enabled == 2) return 0;   /* unsupported: fall back */
+    }
+    return mask;
+}
