+typedef struct { u32 taskset, task; } LfqTaskSignal;
+
+/* ANY2ANY moves this ledger to the ordinary push2 position in the SPU
+ * library. Producer notification and consumer acknowledgement are separate
+ * cursors; advancing the latter here strands consumers before they retry. */
+static int lfq_collect_consumer_signals(u32 q, int32_t published, int32_t depth,
+                                      LfqTaskSignal signals[15], u16* next_pack)
+{
+    u16 pack = ef_r16(q + LFQ_POP + 4);
+    unsigned registered = pack & 31;
+    unsigned acknowledged = (pack >> 5) & 31;
+    unsigned notified = (pack >> 10) & 31;
+    if (registered >= 30 || acknowledged >= 30 || notified >= 30) return -1;
+    int pending = (int)((registered + 30 - notified) % 30);
+    int outstanding = (int)((notified + 30 - acknowledged) % 30);
+    int available = lfq_occupancy(lfq_u16(ef_r16(q + LFQ_POP + 6)), published, depth);
+    int count = available - outstanding;
+    if (count < 0) count = 0;
+    if (count > pending) count = pending;
+    if (count > 15) return -1;
+    u32 owner = (u32)vm_read64(q + LFQ_SIGNAL);
+    for (int i = 0; i < count; ++i) {
+        u16 token = ef_r16(q + 0x32 + 2 * (notified % 15));
+        u32 wid = token >> 8, task = token & 255;
+        if (wid >= 16 || task >= 128) return -1;
+        u32 taskset = owner;
+        if (owner & 15u) {
+            u32 spurs = owner & ~15u;
+            if (!spurs_guest_range_valid(spurs, SPURS_INST_SIZE)) return -1;
+            taskset = (u32)vm_read64(spurs + SPURS_WKL_INFO1 + wid * SPURS_WKL_INFO_SZ + 8);
+        }
+        if (!taskset || !spurs_guest_range_valid(taskset, 0x80)) return -1;
+        signals[i].taskset = taskset;
+        signals[i].task = task;
+        notified = (notified + 1) % 30;
+    }
+    *next_pack = (u16)((pack & 0x83FFu) | (notified << 10));
+    return count;
 }
 
