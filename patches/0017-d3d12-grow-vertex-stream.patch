+
+static u32 vp_capacity_for(u32 capacity, u32 required)
+{
+    if (!capacity) capacity = 1;
+    if (required > 4194304u) return 0;
+    while (capacity < required) capacity *= 2u;
+    return capacity;
+}
+
+static void vp_copy_vertex_frames(void* dst, u32 new_capacity, const void* src, u32 old_capacity)
+{
+    for (u32 parity = 0; parity < 2; ++parity)
+        memcpy((char*)dst + (u64)parity * new_capacity * 256u,
+               (const char*)src + (u64)parity * old_capacity * 256u,
+               (u64)old_capacity * 256u);
+}
+
+static int vp_reserve_vertices(u32 extra)
+{
+    u32 required = s_d3d.vp_vb_offset / 256u + extra;
+    if (required <= s_d3d.vp_vertex_capacity) return 1;
+    u32 capacity = vp_capacity_for(s_d3d.vp_vertex_capacity, required);
+    if (!capacity) { fprintf(stderr, "[VPVB] frame exceeds supported upload size\n"); return 0; }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = (u64)capacity * 256u * 2u;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* resource = NULL; void* mapped = NULL;
+    D3D12_RANGE empty = {0,0};
+    HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+        D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+        &IID_ID3D12Resource, (void**)&resource);
+    if (SUCCEEDED(hr)) hr = resource->lpVtbl->Map(resource, 0, &empty, &mapped);
+    if (FAILED(hr) || !mapped) {
+        if (resource) resource->lpVtbl->Release(resource);
+        fprintf(stderr, "[VPVB] cannot grow upload buffer to %u vertices (hr=%08X)\n", capacity, (unsigned)hr);
+        return 0;
+    }
+    /* Previous frames still reference the old upload buffer. Preserve both
+     * parity regions and release it only after their GPU work completes. */
+    wait_for_gpu();
+    vp_copy_vertex_frames(mapped, capacity, s_d3d.vp_vb_mapped, s_d3d.vp_vertex_capacity);
+    s_d3d.vp_vb->lpVtbl->Unmap(s_d3d.vp_vb, 0, NULL);
+    s_d3d.vp_vb->lpVtbl->Release(s_d3d.vp_vb);
+    s_d3d.vp_vb = resource; s_d3d.vp_vb_mapped = mapped;
+    s_d3d.vp_vertex_capacity = capacity;
+    fprintf(stderr, "[VPVB] grew to %u vertices per frame (%llu MB)\n", capacity, (unsigned long long)(bd.Width >> 20));
+    return 1;
 }

