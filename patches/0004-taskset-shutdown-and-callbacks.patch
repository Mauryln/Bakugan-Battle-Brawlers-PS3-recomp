+ * and the host exit path, rather than racing their bitset updates. */
+void spurs_taskset_wait_idle(uint32_t taskset_ea)
+{
+    extern void spu_lockline_lock(void);
+    extern void spu_lockline_unlock(void);
+    extern uint8_t* vm_base;
