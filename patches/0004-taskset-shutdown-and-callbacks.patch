+/* Host lifecycle state, kept outside the SDK's guest-memory layout. All
+ * readers use a host lifecycle lock; reinitialization removes the old state. */
+#include <stdlib.h>
+#include <stdatomic.h>
+typedef struct ShutdownTaskset {
+    uint32_t ea;
+    struct ShutdownTaskset* next;
+} ShutdownTaskset;
+static ShutdownTaskset* shutdown_tasksets;
+extern void spu_lockline_lock(void);
+extern void spu_lockline_unlock(void);
+
+static atomic_flag shutdown_state_lock = ATOMIC_FLAG_INIT;
+static void shutdown_lock(void) {
+    while (atomic_flag_test_and_set_explicit(&shutdown_state_lock, memory_order_acquire)) { }
+}
+static void shutdown_unlock(void) {
+    atomic_flag_clear_explicit(&shutdown_state_lock, memory_order_release);
+}
+
+static void taskset_reset_shutdown(uint32_t ea)
+{
+    ShutdownTaskset* removed = NULL;
+    shutdown_lock();
+    for (ShutdownTaskset** p = &shutdown_tasksets; *p; p = &(*p)->next) {
+        if ((*p)->ea == ea) { removed = *p; *p = removed->next; break; }
+    }
+    shutdown_unlock();
+    free(removed);
+}
+
+int spurs_taskset_is_shutting_down(uint32_t ea)
+{
+    int result = 0;
+    shutdown_lock();
+    for (ShutdownTaskset* p = shutdown_tasksets; p; p = p->next)
+        if (p->ea == ea) { result = 1; break; }
+    shutdown_unlock();
+    return result;
+}
+
+int spurs_taskset_request_shutdown(uint32_t ea)
+{
+    ShutdownTaskset* entry = malloc(sizeof(*entry));
+    if (!entry) return 0;
+    entry->ea = ea;
+    shutdown_lock();
+    for (ShutdownTaskset* p = shutdown_tasksets; p; p = p->next) {
+        if (p->ea == ea) { shutdown_unlock(); free(entry); return 1; }
+    }
+    entry->next = shutdown_tasksets;
+    shutdown_tasksets = entry;
+    shutdown_unlock();
+    return 1;
+}
 
