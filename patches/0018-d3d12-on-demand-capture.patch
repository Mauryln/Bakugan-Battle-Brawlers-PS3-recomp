+    /* Exact inputs for small display draws: diagnose HUD coordinates, colour
+     * and constants without altering the game's screen. Count-delimited blocks:
+     * draw index/count/CB stride/FP stride, vertices, VP constants, FP constants. */
+    snprintf(path, sizeof path, "%s/display_inputs.bin", dir);
+    FILE* inputs = fopen(path, "wb");
+    if (inputs && s_d3d.vp_vb_mapped && s_d3d.vp_cb_mapped && s_d3d.vp_fpcb_mapped) {
+        u32 parity = (u32)(s_d3d.vp_parity ^ 1);
+        for (u32 d = 0; d < ndraws && d < MAX_DRAWS; ++d) {
+            const D3D12DrawRecord* r = &s_d3d.draws[d];
+            if (!r->is_vp || r->is_clear || r->rt_off || !r->vertex_count || r->vertex_count > 128) continue;
+            u32 header[4] = {d, r->vertex_count, VP_CB_STRIDE, VP_FPCB_STRIDE};
+            fwrite(header, sizeof(header), 1, inputs);
+            fwrite((char*)s_d3d.vp_vb_mapped + (u64)parity * s_d3d.vp_vertex_capacity * 256u + r->vb_byte_offset,
+                   256u, r->vertex_count, inputs);
+            fwrite((char*)s_d3d.vp_cb_mapped + ((u64)parity * MAX_DRAWS + r->cb_slot) * VP_CB_STRIDE,
+                   1, VP_CB_STRIDE, inputs);
+            fwrite((char*)s_d3d.vp_fpcb_mapped + ((u64)parity * MAX_DRAWS + r->cb_slot) * VP_FPCB_STRIDE,
+                   1, VP_FPCB_STRIDE, inputs);
+        }
+    }
+    if (inputs) fclose(inputs);
     printf("[RSXCAP] frame %llu -> %s (%u ops)\n",
