+static void handle_pending_resize(void)
+{
+    u32 new_w = s_d3d.pending_resize_width;
+    u32 new_h = s_d3d.pending_resize_height;
+    s_d3d.pending_resize_width = 0;
+    s_d3d.pending_resize_height = 0;
+    if (!new_w || !new_h || !s_d3d.swap_chain) return;
+    if (new_w == s_d3d.present_width && new_h == s_d3d.present_height) return;
+
+    wait_for_gpu();
+    if (s_d3d.custom_swapchain && s_swapchain_provider.resize)
+        s_swapchain_provider.resize(s_d3d.swap_chain, new_w, new_h);
+
+    for (u32 i = 0; i < FRAME_COUNT; i++) {
+        if (s_output_pass_ready) {
+            if (s_d3d.output_targets[i]) {
+                s_d3d.output_targets[i]->lpVtbl->Release(s_d3d.output_targets[i]);
+                s_d3d.output_targets[i] = NULL;
+            }
+            if (s_d3d.hudless_output[i]) {
+                s_d3d.hudless_output[i]->lpVtbl->Release(s_d3d.hudless_output[i]);
+                s_d3d.hudless_output[i] = NULL;
+            }
+        } else {
+            if (s_d3d.render_targets[i]) {
+                s_d3d.render_targets[i]->lpVtbl->Release(s_d3d.render_targets[i]);
+                s_d3d.render_targets[i] = NULL;
+            }
+        }
+    }
+
+    HRESULT hr = s_d3d.swap_chain->lpVtbl->ResizeBuffers(
+        s_d3d.swap_chain, FRAME_COUNT, new_w, new_h,
+        DXGI_FORMAT_R8G8B8A8_UNORM, 0);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[D3D12] ResizeBuffers(%ux%u) failed (0x%08lX)\n",
+                new_w, new_h, (unsigned long)hr);
+    } else {
+        s_d3d.present_width = new_w;
+        s_d3d.present_height = new_h;
+    }
+
+    s_d3d.frame_index = s_d3d.swap_chain->lpVtbl->GetCurrentBackBufferIndex(s_d3d.swap_chain);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv_handle = s_d3d.rtv_heap_cpu_base;
+    for (u32 i = 0; i < FRAME_COUNT; i++) {
+        hr = s_d3d.swap_chain->lpVtbl->GetBuffer(
+            s_d3d.swap_chain, i, &IID_ID3D12Resource,
+            s_output_pass_ready ? (void**)&s_d3d.output_targets[i]
+                                : (void**)&s_d3d.render_targets[i]);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[D3D12] GetBuffer(%u) after resize failed (0x%08lX)\n",
+                    i, (unsigned long)hr);
+            return;
+        }
+        if (!s_output_pass_ready) {
+            s_d3d.device->lpVtbl->CreateRenderTargetView(
+                s_d3d.device, s_d3d.render_targets[i], NULL, rtv_handle);
+        }
+        rtv_handle.ptr += s_d3d.rtv_descriptor_size;
+    }
+
+    if (s_output_pass_ready) {
+        s_output_pass.width = s_d3d.present_width;
+        s_output_pass.height = s_d3d.present_height;
+        if (s_output_pass.resize &&
+            s_output_pass.resize(s_output_pass.userdata, s_d3d.present_width, s_d3d.present_height) != 0) {
+            fprintf(stderr, "[OUTPUT] resize(%ux%u) failed\n",
+                    s_d3d.present_width, s_d3d.present_height);
+        }
+    }
+}
