@@ -32,4 +32,38 @@
     return flips ? (double)cellGcm_flip_request_count()
                  : (double)(GetTickCount64() - t0_ms) / 1000.0;
+}
+
+/* A button-driven Sixaxis forward impulse, followed by the braking impulse.
+ * Use elapsed time so the gesture is independent of guest polling frequency. */
+typedef struct {
+    u64 start_ms;
+    int held;
+    int active;
+} PadMotionPulse;
+
+static PadMotionPulse s_motion_pulse[4];
+
+static void pad_forward_motion(u16* sensors, int pressed, u64 now_ms,
+                                PadMotionPulse* pulse)
+{
+    sensors[0] = 512; sensors[1] = 399;
+    sensors[2] = 512; sensors[3] = 512;
+    if (pressed && !pulse->held) {
+        pulse->start_ms = now_ms;
+        pulse->active = 1;
+    }
+    pulse->held = pressed;
+    if (!pulse->active) return;
+    u64 elapsed = now_ms - pulse->start_ms;
+    if (elapsed < 100) sensors[2] = 1023;
+    else if (elapsed < 200) sensors[2] = 0;
+    else pulse->active = 0;
+}
+
+/* I/K: vertical acceleration; J/L: lateral acceleration. Opposites cancel. */
+static void pad_direction_motion(u16* sensors, int up, int down, int left, int right)
+{
+    sensors[1] = up == down ? 399 : (up ? 0 : 1023);
+    sensors[0] = left == right ? 512 : (left ? 0 : 1023);
 }

@@ -536,4 +570,5 @@
     memset(s_port_setting, 0, sizeof(s_port_setting));
     memset(s_host_state, 0, sizeof(s_host_state));
