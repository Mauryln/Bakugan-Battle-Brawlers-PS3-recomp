diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -740,6 +740,22 @@
     (void)spu_channel_try_write(ch, val, SPU_CHANNEL_CAP);
 }
 
+/* Prepend synchronous SPU-thread syscall acks ahead of concurrent PPU mailbox writes. */
+static inline int spu_channel_push_front(spu_channel* ch, uint32_t val)
+{
+    SPU_CH_LOCK(ch);
+    if (ch->count >= SPU_CHANNEL_CAP) {
+        SPU_CH_UNLOCK(ch);
+        return 0;
+    }
+    ch->head = (ch->head + SPU_CHANNEL_CAP - 1u) % SPU_CHANNEL_CAP;
+    ch->q[ch->head] = val;
+    ch->value = val;
+    ch->count++;
+    SPU_CH_UNLOCK(ch);
+    return 1;
+}
+
 static inline uint32_t spu_channel_read(spu_channel* ch)
 {
     SPU_CH_LOCK(ch);
