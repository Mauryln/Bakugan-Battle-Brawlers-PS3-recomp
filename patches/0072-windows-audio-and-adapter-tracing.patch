  * which is what made the flicker appear exactly where shadow casters are. */
 void ps3_guest_stamp(uint32_t ea, uint32_t n)
 {
+#ifdef _WIN32
+    /* Port 1 has the Multistream output ring. Its 8 x 8 KiB slots fit in
+     * the first 64 KiB. Observe bulk writes after the DMA copy completes. */
+    if ((ea & 0xffff0000u) == VM_AUDIO_BASE + VM_AUDIO_PORT_SIZE) {
+        extern void cell_audio_trace_event(uint32_t, uint32_t, uint32_t);
+        cell_audio_trace_event(1, ea, n);
+    }
+#endif
     uint32_t p = ea >> 12, pe = (ea + (n ? n - 1u : 0u)) >> 12;
     for (; p <= pe; ++p) g_guest_page_gen[p & ((1u << 20) - 1u)] = ++g_guest_gen;
 }
