+void cell_audio_trace_event(uint32_t kind, uint32_t arg0, uint32_t arg1)
+{
+    if (!__atomic_load_n(&s_trace_events_enabled, __ATOMIC_RELAXED)) return;
+    AcquireSRWLockShared(&s_trace_event_lock);
+    if (__atomic_load_n(&s_trace_events_enabled, __ATOMIC_RELAXED)) {
+        const LONG index = InterlockedIncrement(&s_trace_event_count) - 1;
+        if (index < AUDIO_TRACE_CAPACITY) {
