+            QueryPerformanceCounter(&now);
+            s_trace_events[index] = (AudioTraceEvent){
+                now.QuadPart, kind, GetCurrentThreadId(), arg0, arg1
+            };
+        }
+    }
+    ReleaseSRWLockShared(&s_trace_event_lock);
+}
