+static int audio_block_has_pcm(const float* src, u32 samples)
+{
+    for (u32 i = 0; i < samples; ++i) {
+        uint32_t bits;
+        memcpy(&bits, src + i, sizeof bits);
+        if (bits) return 1;
+    }
+    return 0;
+}
