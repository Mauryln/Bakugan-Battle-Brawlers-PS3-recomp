     /* Sanitize non-finite samples and soft-limit peaks above 0.85 into [-1.0, 1.0]
      * so overlapping combat SFX bursts do not produce harsh hard-clip crackle. */
+    int mix_all_zero = 1;
     for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
         float x = s_mix_buffer[i];
         if (!isfinite(x)) {
             s_mix_buffer[i] = 0.0f;
             continue;
         }
+        if (x != 0.0f) mix_all_zero = 0;
         float ax = fabsf(x);
         if (ax > 0.85f) {
             float y = 0.85f + 0.15f * tanhf((ax - 0.85f) / 0.15f);
             if (y > 1.0f) y = 1.0f;
             s_mix_buffer[i] = (x < 0.0f) ? -y : y;
         }
+    }
+
+    /* Smooth brief underrun gaps so abrupt voltage steps do not buzz at ~94 Hz. */
+    if (mix_all_zero) {
+        if (s_prev_mix_lr[0] != 0.0f || s_prev_mix_lr[1] != 0.0f) {
+            for (u32 s = 0; s < 64u; ++s) {
+                float gain = (float)(63u - s) / 64.0f;
+                s_mix_buffer[s * 2 + 0] = s_prev_mix_lr[0] * gain;
+                s_mix_buffer[s * 2 + 1] = s_prev_mix_lr[1] * gain;
+            }
+            s_prev_mix_lr[0] = s_prev_mix_lr[1] = 0.0f;
+        }
+        s_prev_mix_muted = 1;
+    } else {
+        if (s_prev_mix_muted) {
+            for (u32 s = 0; s < 32u; ++s) {
+                float gain = (float)(s + 1u) / 32.0f;
+                s_mix_buffer[s * 2 + 0] *= gain;
+                s_mix_buffer[s * 2 + 1] *= gain;
+            }
+            s_prev_mix_muted = 0;
+        }
+        s_prev_mix_lr[0] = s_mix_buffer[(CELL_AUDIO_BLOCK_SAMPLES - 1u) * 2u + 0u];
+        s_prev_mix_lr[1] = s_mix_buffer[(CELL_AUDIO_BLOCK_SAMPLES - 1u) * 2u + 1u];
     }
 }
 
