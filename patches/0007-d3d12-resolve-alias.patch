+/* Aliased resolves: destination guest offset (64K page) -> live target.
+ *
+ * The guest resolves its scene target with NV3089 into an offscreen buffer and
+ * then samples that buffer as a texture, but this backend renders into a host
+ * resource and never writes colour back to guest memory, so the copy the guest
+ * makes of that buffer carries zeros. When a blit's source is a live target,
+ * remember that the destination holds its contents and sample the target
+ * instead: that is the resolved image as this backend keeps it (the guest's
+ * 2x storage is not simulated, so it is 1:1, not a downsample).
+ * Keyed by 64K page because NV3089 tiles a resolve into several blits that
+ * differ only in their low address bits. */
+static struct { u32 dst, src; } s_rt_alias[8];
+static int s_rt_alias_n;
+
+/* The live target whose guest range holds `off` (tiles land mid-surface). */
+static int off_rt_containing(u32 off)
+{
+    int best = -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || off < r->off) continue;
+        if (off - r->off >= r->w * 4u * r->h) continue;
+        if (best < 0 || r->off > s_d3d.off_rt[best].off) best = i;
+    }
+    return best;
+}
+
+static int off_rt_alias_find(u32 off)
+{
+    const u32 dst = off & ~0xFFFFu;
+    for (int i = 0; i < s_rt_alias_n; i++)
+        if (s_rt_alias[i].dst == dst) return off_rt_find(s_rt_alias[i].src);
+    return -1;
+}
+
+void rsx_d3d12_backend_alias_resolve(u32 dst_off, u32 src_off)
+{
+    const u32 dst = dst_off & ~0xFFFFu;
+    const int s = off_rt_containing(src_off);
+    if (!dst) return;
+    if (s < 0) {
+        /* A real guest copy: the destination's own pixels are the truth again. */
+        for (int i = 0; i < s_rt_alias_n; i++)
+            if (s_rt_alias[i].dst == dst) { s_rt_alias[i] = s_rt_alias[--s_rt_alias_n]; return; }
+        return;
+    }
+    const u32 src = s_d3d.off_rt[s].off;
+    if (dst == src || off_rt_find(dst) >= 0) return;  /* a real target renders here */
+    for (int i = 0; i < s_rt_alias_n; i++)
+        if (s_rt_alias[i].dst == dst) { s_rt_alias[i].src = src; return; }
+    if (s_rt_alias_n < 8) {
+        s_rt_alias[s_rt_alias_n].dst = dst;
+        s_rt_alias[s_rt_alias_n].src = src;
+        s_rt_alias_n++;
+    }
+}
