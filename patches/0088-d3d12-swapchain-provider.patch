+typedef struct rsx_d3d12_present_scene {
+    void* depth;
+    void* hudless;
+    float view[16];
+    float projection[16];
+    float depth_scale, depth_offset;
+} rsx_d3d12_present_scene;
+
+/* Optional swap-chain provider. create returns an owned IDXGISwapChain1 or
+ * NULL to use DXGI directly. record runs before submitting a presented frame
+ * and receives NULL when the batch lacks the requested scene. Otherwise the
+ * depth is in NON_PIXEL_SHADER_RESOURCE and must be left in that state.
+ * drain runs after the game queue is idle, before releasing swap-chain buffers. */
+typedef struct rsx_d3d12_swapchain_provider {
+    u32 scene_color_offset, scene_width, scene_height;
+    void* (*create)(void* hwnd, const void* desc, void* queue, void* factory);
+    void (*record)(void* command_list, const rsx_d3d12_present_scene* scene);
+    void (*drain)(void* swapchain);
+} rsx_d3d12_swapchain_provider;
+int rsx_d3d12_backend_set_swapchain_provider(const rsx_d3d12_swapchain_provider* provider);
 
