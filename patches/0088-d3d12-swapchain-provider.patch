+static void fps_title_on_present(void)
+{
+    UINT present_count = s_d3d.fps_title_last_present + 1;
+    /* A provider can submit extra presents for one guest frame. */
+    if (s_d3d.custom_swapchain && FAILED(s_d3d.swap_chain->lpVtbl->GetLastPresentCount(
+            s_d3d.swap_chain, &present_count))) return;
+
+    u64 now = GetTickCount64();
+    if (!s_d3d.fps_title_start) s_d3d.fps_title_start = now;
+    else s_d3d.fps_title_presents += present_count - s_d3d.fps_title_last_present;
+    s_d3d.fps_title_last_present = present_count;
+    u64 elapsed = now - s_d3d.fps_title_start;
+    if (elapsed >= 1000) {
+        char title[160];
+        snprintf(title, sizeof(title), "%s | FPS: %.1f", g_rsx_title_base,
+                 1000.0 * s_d3d.fps_title_presents / (double)elapsed);
+        SetWindowTextA(s_d3d.hwnd, title);
+        s_d3d.fps_title_start = now;
+        s_d3d.fps_title_presents = 0;
+    }
+}
