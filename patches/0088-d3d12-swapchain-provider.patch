+static ID3D12Resource* create_hudless_target(u32 width, u32 height, D3D12_RESOURCE_FLAGS flags)
+{
+    D3D12_HEAP_PROPERTIES heap = {0};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC texture = {0};
+    texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    texture.Width = width;
+    texture.Height = height;
+    texture.DepthOrArraySize = texture.MipLevels = 1;
+    texture.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    texture.SampleDesc.Count = 1;
+    texture.Flags = flags;
+    ID3D12Resource* result = NULL;
+    s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &heap, D3D12_HEAP_FLAG_NONE,
+        &texture, D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void**)&result);
+    return result;
+}
+
+static int capture_hudless(u32 fi)
+{
+    if (!s_d3d.hudless_native[fi])
+        s_d3d.hudless_native[fi] = create_hudless_target(s_d3d.width, s_d3d.height, D3D12_RESOURCE_FLAG_NONE);
+    if (!s_d3d.hudless_native[fi]) return 0;
+    D3D12_RESOURCE_BARRIER barriers[2] = {0};
+    barriers[0].Type = barriers[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barriers[0].Transition.Subresource = barriers[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barriers[0].Transition.pResource = s_d3d.render_targets[fi];
+    barriers[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    barriers[1].Transition.pResource = s_d3d.hudless_native[fi];
+    barriers[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+    barriers[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    ID3D12GraphicsCommandList* list = s_d3d.cmd_list;
+    list->lpVtbl->ResourceBarrier(list, 2, barriers);
+    list->lpVtbl->CopyResource(list, s_d3d.hudless_native[fi], s_d3d.render_targets[fi]);
+    barriers[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    barriers[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barriers[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    barriers[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+    list->lpVtbl->ResourceBarrier(list, 2, barriers);
+    return 1;
+}
+
+static ID3D12Resource* output_hudless(u32 fi)
+{
+    if (!s_output_pass_ready) return s_d3d.hudless_native[fi];
+    if (!s_output_pass.record_hudless) return NULL;
+    if (!s_d3d.hudless_output[fi])
+        s_d3d.hudless_output[fi] = create_hudless_target(s_output_pass.width, s_output_pass.height,
+                                                       D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET);
+    if (!s_d3d.hudless_output[fi]) return NULL;
+    if (s_output_pass.record_hudless(s_output_pass.userdata, s_d3d.cmd_list,
+            s_d3d.hudless_native[fi], s_d3d.hudless_output[fi], fi)) return NULL;
+    return s_d3d.hudless_output[fi];
+}
