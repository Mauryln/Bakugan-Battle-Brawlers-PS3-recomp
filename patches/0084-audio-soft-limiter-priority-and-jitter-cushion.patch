+static u32 audio_backend_queued_frames(int room)
+{
+    if (room < 0 || (u32)room >= s_wasapi_buf_frames) return 0;
+    return s_wasapi_buf_frames - (u32)room;
 }
 
 
@@ -815,11 +821,44 @@
         }
     }
 
-    /* Clip to [-1.0, 1.0] */
+    /* Sanitize non-finite samples and soft-limit peaks above 0.85 into [-1.0, 1.0]
+     * so overlapping combat SFX bursts do not produce harsh hard-clip crackle. */
     for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
-        if (s_mix_buffer[i] > 1.0f) s_mix_buffer[i] = 1.0f;
-        if (s_mix_buffer[i] < -1.0f) s_mix_buffer[i] = -1.0f;
-    }
+        float x = s_mix_buffer[i];
+        if (!isfinite(x)) {
+            s_mix_buffer[i] = 0.0f;
+            continue;
+        }
+        float ax = fabsf(x);
+        if (ax > 0.85f) {
+            float y = 0.85f + 0.15f * tanhf((ax - 0.85f) / 0.15f);
+            if (y > 1.0f) y = 1.0f;
+            s_mix_buffer[i] = (x < 0.0f) ? -y : y;
+        }
+    }
+}
+
+static int audio_port_needs_jitter_cushion(int* out_port)
+{
+    int needs = 0;
+    mutex_lock(&s_audio_mutex);
+    for (int p = 0; p < CELL_AUDIO_PORT_MAX; ++p) {
+        AudioPortSlot* port = &s_ports[p];
+        if (!port->in_use || !port->running || !port->buffer) continue;
+        if (!s_port_ever_had_pcm[p] || s_port_underrun_streak[p] > 0) continue;
+        u32 nch = (u32)port->param.nChannel;
+        u32 nblock = (u32)port->param.nBlock;
+        u32 block_idx = (u32)(port->read_index % nblock);
+        u32 samples = CELL_AUDIO_BLOCK_SAMPLES * nch;
+        const float* src = port->buffer + block_idx * samples;
+        if (!audio_debug_slot_nonzero(src, samples)) {
+            if (out_port) *out_port = p;
+            needs = 1;
+            break;
+        }
+    }
+    mutex_unlock(&s_audio_mutex);
+    return needs;
 }
 
