+/* The backend snapshots constants after the four texscale vectors and alpha
+ * state. Use buffered translation so the instruction-only PSO key is valid. */
+static int fp_decompile_for_draw(const u8* ucode, u32 max_bytes, u32 ctrl,
+                                 u32 cube_mask, char* hlsl, u32 out_size)
+{
+    u32 count = 0;
+    int n = rsx_fp_decompile_buffered_ex(ucode, max_bytes, ctrl, cube_mask,
+                                        hlsl, out_size, &count);
+    if (n <= 0 || count > 64) return -1;
+    char declaration[192];
+    snprintf(declaration, sizeof declaration,
+             "cbuffer PSConstants : register(b1) {\n"
+             "    float4 fp_constants[%u];\n"
+             "    float4 fp_alpha;\n};\n", count ? count : 1u);
+    hlsl_replace_all(hlsl, out_size, declaration,
+        "cbuffer PSConstants : register(b1) {\n"
+        "    float4 rsx_texscale[4];\n"
+        "    float4 rsx_alphatest;\n"
+        "    float4 fp_constants[64];\n};\n");
+    return n;
+}
+
+/* Include every translation input by hashing the final compiler source. This
+ * also isolates diagnostic shader rewrites from normal cached bytecode. */
+static void fp_shader_cache_path(char* path, size_t size, const char* hlsl)
+{
+    u64 hash = 14695981039346656037ull;
+    for (const unsigned char* p = (const unsigned char*)hlsl; *p; p++) {
+        hash ^= *p;
+        hash *= 1099511628211ull;
+    }
+    snprintf(path, size, "shadercache/fp_hlsl_v1_%016llX.dxbc",
+             (unsigned long long)hash);
 }

