--- /dev/null
+++ b/include/ps3emu/host_input.h
@@ -0,0 +1,21 @@
+#ifndef PS3EMU_HOST_INPUT_H
+#define PS3EMU_HOST_INPUT_H
+#include "ps3types.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Optional title host input provider. Install before guest threads start.
+ * The callback returns an owned snapshot and must be safe from any guest thread.
+ * Returning zero preserves the existing backend for that port. */
+typedef struct ps3_host_pad_report {
+    u16 buttons;
+    u8 lx, ly, rx, ry, l2, r2;
+    u16 sensors[4];
+    u8 sensors_valid;
+} ps3_host_pad_report;
+typedef int (*ps3_host_pad_provider)(u32 port, ps3_host_pad_report* out, void* userdata);
+void ps3_pad_set_host_provider(ps3_host_pad_provider provider, void* userdata);
+#ifdef __cplusplus
+}
+#endif
+#endif
