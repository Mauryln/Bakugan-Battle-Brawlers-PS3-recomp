+static int ui_dump_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* e = getenv("BAKUGAN_DUMP_UI_TEX");
+        if (!e || !*e || strcmp(e, "0") == 0) mode = 0;
+        else {
+            int v = atoi(e);
+            mode = (v > 0) ? v : 1;
+        }
+    }
+    return mode;
+}
+
+static void ui_dump_texture_once(u64 ui_hash, const u8* src, u32 w, u32 h,
+                                 u32 fmt, u32 mips, u32 pitch, const rsx_tex_layout* tl)
+{
+#if RSX_HAS_STB_IMAGE_WRITE
+    for (u32 i = 0; i < s_ui_dump_seen_n; i++)
+        if (s_ui_dump_seen[i] == ui_hash) return;
+    if (s_ui_dump_seen_n < UI_DUMP_SEEN_MAX)
+        s_ui_dump_seen[s_ui_dump_seen_n++] = ui_hash;
+
+    if (!s_ui_dump_dir_ready) {
+        CreateDirectoryA("diagnostics", NULL);
+        CreateDirectoryA("diagnostics\\ui_tex_dump", NULL);
+        s_ui_dump_dir_ready = 1;
+    }
+    u8* rgba = (u8*)malloc((size_t)w * h * 4u);
+    if (!rgba) return;
+    if (tl->fmt == RSX_TEXFMT_R8G8B8A8) {
+        rsx_texture_decode(rgba, w * 4u, src, w, h, tl, rsx_texture_argb_is_rgba());
+    } else if (tl->fmt == RSX_TEXFMT_BC1 || tl->fmt == RSX_TEXFMT_BC2 || tl->fmt == RSX_TEXFMT_BC3) {
+        ui_decode_bc_to_rgba8(rgba, src, w, h, tl);
+    } else {
+        free(rgba);
+        return;
+    }
+    char png_path[MAX_PATH];
+    snprintf(png_path, sizeof png_path, "diagnostics\\ui_tex_dump\\%016llx_%ux%u_fmt%02X.png",
+             (unsigned long long)ui_hash, w, h, fmt & 0xFFu);
+    if (stbi_write_png(png_path, (int)w, (int)h, 4, rgba, (int)(w * 4u))) {
+        FILE* mf = fopen("diagnostics\\ui_tex_dump\\manifest.tsv", "ab");
+        if (mf) {
+            fprintf(mf, "%016llx\t%u\t%u\t0x%02X\t%u\t%u\t%s\n",
+                    (unsigned long long)ui_hash, w, h, fmt & 0xFFu, mips, pitch, png_path);
+            fclose(mf);
+        }
+        fprintf(stderr, "[UI_DUMP] %s (%ux%u fmt=0x%02X mips=%u)\n",
+                png_path, w, h, fmt & 0xFFu, mips);
+    }
+    free(rgba);
+#else
+    (void)ui_hash; (void)src; (void)w; (void)h; (void)fmt; (void)mips; (void)pitch; (void)tl;
+#endif
+}
+
+static void ui_upload_rgba8_mips(u8* mapped_base, const u8* rgba, u32 w, u32 h, u32 level_count,
+                                 const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* footprints)
+{
+    for (u32 y = 0; y < h; y++)
+        memcpy(mapped_base + footprints[0].Offset + (size_t)y * footprints[0].Footprint.RowPitch,
+               rgba + (size_t)y * w * 4u, (size_t)w * 4u);
+    if (level_count <= 1u) return;
+
+    u32 cw = w > 1u ? w / 2u : 1u;
+    u32 ch = h > 1u ? h / 2u : 1u;
+    u8* cur = (u8*)malloc((size_t)cw * ch * 4u);
+    u8* nxt = (u8*)malloc((size_t)cw * ch * 4u);
+    if (!cur || !nxt) {
+        free(cur);
+        free(nxt);
+        return;
+    }
+    const u8* src = rgba;
+    u32 sw = w, sh = h;
+    for (u32 mip = 1u; mip < level_count; mip++) {
+        u32 nw = sw > 1u ? sw / 2u : 1u;
+        u32 nh = sh > 1u ? sh / 2u : 1u;
+        u8* dst = (mip & 1u) ? cur : nxt;
+        for (u32 y = 0; y < nh; y++) {
+            u32 y0 = y * 2u;
+            u32 y1 = (y0 + 1u < sh) ? (y0 + 1u) : y0;
+            for (u32 x = 0; x < nw; x++) {
+                u32 x0 = x * 2u;
+                u32 x1 = (x0 + 1u < sw) ? (x0 + 1u) : x0;
+                const u8* p00 = src + ((size_t)y0 * sw + x0) * 4u;
+                const u8* p10 = src + ((size_t)y0 * sw + x1) * 4u;
+                const u8* p01 = src + ((size_t)y1 * sw + x0) * 4u;
+                const u8* p11 = src + ((size_t)y1 * sw + x1) * 4u;
+                u8* q = dst + ((size_t)y * nw + x) * 4u;
+                for (u32 c = 0; c < 4u; c++)
+                    q[c] = (u8)((p00[c] + p10[c] + p01[c] + p11[c] + 2u) >> 2);
+            }
+        }
+        u8* mptr = mapped_base + footprints[mip].Offset;
+        u32 mpitch = footprints[mip].Footprint.RowPitch;
+        for (u32 y = 0; y < nh; y++)
+            memcpy(mptr + (size_t)y * mpitch, dst + (size_t)y * nw * 4u, (size_t)nw * 4u);
+        src = dst;
+        sw = nw;
+        sh = nh;
+    }
+    free(cur);
+    free(nxt);
+}
+
 static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips, u32 source_pitch)
