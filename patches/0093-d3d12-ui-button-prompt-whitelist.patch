+/* ---------------------------------------------------------------------------
+ * Whitelisted 2D UI button-prompt replacement & UI texture dumper
+ * -----------------------------------------------------------------------*/
+#define UI_PROMPT_MAX_ENTRIES 256u
+#define UI_DUMP_SEEN_MAX      512u
+
+typedef struct {
+    u64  hash;
+    u32  w, h;
+    u8*  rgba;
+    char path[MAX_PATH];
+    int  loaded;
+} UIPromptEntry;
+
+typedef struct {
+    int           scanned;
+    u32           count;
+    UIPromptEntry entries[UI_PROMPT_MAX_ENTRIES];
+} UIPromptWhitelist;
+
+static volatile LONG     s_button_prompt_style = RSX_BUTTON_PROMPTS_PLAYSTATION;
+static volatile LONG     s_button_prompt_gen   = 1;
+static int               s_frame_prompt_style  = RSX_BUTTON_PROMPTS_PLAYSTATION;
+static u32               s_frame_prompt_gen    = 1;
+static UIPromptWhitelist s_ui_prompts[3];
+static u64               s_ui_dump_seen[UI_DUMP_SEEN_MAX];
+static u32               s_ui_dump_seen_n      = 0;
+static int               s_ui_dump_dir_ready   = 0;
+
+void rsx_d3d12_backend_set_button_prompts(int style)
+{
+    if (style < RSX_BUTTON_PROMPTS_PLAYSTATION || style > RSX_BUTTON_PROMPTS_NINTENDO)
+        style = RSX_BUTTON_PROMPTS_PLAYSTATION;
+    if (InterlockedExchange(&s_button_prompt_style, (LONG)style) != (LONG)style)
+        InterlockedIncrement(&s_button_prompt_gen);
+}
+
+int rsx_d3d12_backend_get_button_prompts(void)
+{
+    return (int)InterlockedCompareExchange(&s_button_prompt_style, 0, 0);
+}
+
+static int vpchk_on(void);
+
+static int ui_dir_exists(const char* path)
+{
+    DWORD attr = GetFileAttributesA(path);
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY) != 0;
+}
+
+static int ui_prompt_find_root(char* out, size_t cap)
+{
+    const char* env_dir = getenv("BAKUGAN_BUTTON_PROMPTS_DIR");
+    if (env_dir && *env_dir && ui_dir_exists(env_dir)) {
+        snprintf(out, cap, "%s", env_dir);
+        return 1;
+    }
+    char exe_dir[MAX_PATH];
+    DWORD len = GetModuleFileNameA(NULL, exe_dir, (DWORD)sizeof exe_dir);
+    if (len > 0 && len < sizeof exe_dir) {
+        char* slash = strrchr(exe_dir, '\\');
+        if (!slash) slash = strrchr(exe_dir, '/');
+        if (slash) {
+            *slash = '\0';
+            static const char* const kRel[] = {
+                "%s\\assets\\button_prompts",
+                "%s\\..\\assets\\button_prompts",
+                "%s\\..\\..\\bakugan-recomp\\assets\\button_prompts",
+            };
+            for (size_t i = 0; i < sizeof kRel / sizeof kRel[0]; i++) {
+                snprintf(out, cap, kRel[i], exe_dir);
+                if (ui_dir_exists(out)) return 1;
+            }
+        }
+    }
+    static const char* const kCwd[] = {
+        "bakugan-recomp\\assets\\button_prompts",
+        "assets\\button_prompts",
+    };
+    for (size_t i = 0; i < sizeof kCwd / sizeof kCwd[0]; i++) {
+        if (ui_dir_exists(kCwd[i])) {
+            snprintf(out, cap, "%s", kCwd[i]);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int ui_prompt_parse_hex16(const char* filename, u64* out_hash)
+{
+    if (!filename) return 0;
+    size_t n = strlen(filename);
+    if (n != 20) return 0;
+    if (_stricmp(filename + 16, ".png") != 0) return 0;
+    u64 val = 0;
+    for (size_t i = 0; i < 16; i++) {
+        unsigned char c = (unsigned char)filename[i];
+        u64 digit;
+        if (c >= '0' && c <= '9') digit = (u64)(c - '0');
+        else if (c >= 'a' && c <= 'f') digit = (u64)(c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F') digit = (u64)(c - 'A' + 10);
+        else return 0;
+        val = (val << 4) | digit;
+    }
+    *out_hash = val;
+    return 1;
+}
+
+static void ui_prompt_scan_style(int style)
+{
+    if (style != RSX_BUTTON_PROMPTS_XBOX && style != RSX_BUTTON_PROMPTS_NINTENDO)
+        return;
+    UIPromptWhitelist* wl = &s_ui_prompts[style];
+    if (wl->scanned) return;
+    wl->scanned = 1;
+#if RSX_HAS_STB_IMAGE
+    char root[MAX_PATH];
+    if (!ui_prompt_find_root(root, sizeof root)) return;
+    const char* sub = (style == RSX_BUTTON_PROMPTS_XBOX) ? "xbox" : "nintendo";
+    char dir[MAX_PATH], pattern[MAX_PATH];
+    snprintf(dir, sizeof dir, "%s\\%s", root, sub);
+    if (!ui_dir_exists(dir)) return;
+    snprintf(pattern, sizeof pattern, "%s\\*.png", dir);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(pattern, &fd);
+    if (h == INVALID_HANDLE_VALUE) return;
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        u64 hash = 0;
+        if (!ui_prompt_parse_hex16(fd.cFileName, &hash)) continue;
+        if (wl->count >= UI_PROMPT_MAX_ENTRIES) break;
+        char full[MAX_PATH];
+        snprintf(full, sizeof full, "%s\\%s", dir, fd.cFileName);
+        int pw = 0, ph = 0, pcomp = 0;
+        if (!stbi_info(full, &pw, &ph, &pcomp)) continue;
+        if (pw < 16 || ph < 16 || pw > 1024 || ph > 1024) continue;
+        UIPromptEntry* e = &wl->entries[wl->count++];
+        memset(e, 0, sizeof *e);
+        e->hash = hash;
+        e->w = (u32)pw;
+        e->h = (u32)ph;
+        snprintf(e->path, sizeof e->path, "%s", full);
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+    if (wl->count > 0)
+        fprintf(stderr, "[UI_PROMPTS] loaded %u whitelisted atlas(es) from %s\n", wl->count, dir);
+#endif
+}
+
+static int ui_prompt_style_has_size(int style, u32 w, u32 h)
+{
+    if (style != RSX_BUTTON_PROMPTS_XBOX && style != RSX_BUTTON_PROMPTS_NINTENDO)
+        return 0;
+    UIPromptWhitelist* wl = &s_ui_prompts[style];
+    if (!wl->scanned) ui_prompt_scan_style(style);
+    for (u32 i = 0; i < wl->count; i++)
+        if (wl->entries[i].w == w && wl->entries[i].h == h)
+            return 1;
+    return 0;
+}
+
+static const u8* ui_prompt_lookup(int style, u64 hash, u32 w, u32 h)
+{
+    if (style != RSX_BUTTON_PROMPTS_XBOX && style != RSX_BUTTON_PROMPTS_NINTENDO)
+        return NULL;
+    UIPromptWhitelist* wl = &s_ui_prompts[style];
+    if (!wl->scanned) ui_prompt_scan_style(style);
+    for (u32 i = 0; i < wl->count; i++) {
+        UIPromptEntry* e = &wl->entries[i];
+        if (e->hash != hash || e->w != w || e->h != h) continue;
+#if RSX_HAS_STB_IMAGE
+        if (!e->loaded) {
+            e->loaded = 1;
+            FILE* f = fopen(e->path, "rb");
+            if (!f) return NULL;
+            if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
+            long fsz = ftell(f);
+            if (fsz <= 0 || fsz > 16L * 1024L * 1024L || fseek(f, 0, SEEK_SET) != 0) {
+                fclose(f);
+                return NULL;
+            }
+            u8* buf = (u8*)malloc((size_t)fsz);
+            if (!buf) { fclose(f); return NULL; }
+            size_t rd = fread(buf, 1, (size_t)fsz, f);
+            fclose(f);
+            if (rd != (size_t)fsz) { free(buf); return NULL; }
+            int pw = 0, ph = 0, comp = 0;
+            u8* rgba = stbi_load_from_memory(buf, (int)fsz, &pw, &ph, &comp, 4);
+            free(buf);
+            if (!rgba || (u32)pw != w || (u32)ph != h) {
+                if (rgba) stbi_image_free(rgba);
+                return NULL;
+            }
+            e->rgba = rgba;
+        }
+#endif
+        return e->rgba;
+    }
+    return NULL;
+}
+
+static void ui_prompt_whitelist_shutdown(void)
+{
+    for (int s = 0; s < 3; s++) {
+        for (u32 i = 0; i < s_ui_prompts[s].count; i++) {
+            if (s_ui_prompts[s].entries[i].rgba) {
+#if RSX_HAS_STB_IMAGE
+                stbi_image_free(s_ui_prompts[s].entries[i].rgba);
+#endif
+                s_ui_prompts[s].entries[i].rgba = NULL;
+            }
+        }
+        memset(&s_ui_prompts[s], 0, sizeof s_ui_prompts[s]);
+    }
+    s_ui_dump_seen_n = 0;
+    s_ui_dump_dir_ready = 0;
+}
+
+static u64 ui_fnv1a64(u64 hval, const u8* p, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        hval ^= (u64)p[i];
+        hval *= 0x100000001b3ULL;
+    }
+    return hval;
+}
+
+static u64 ui_tex_content_hash(const u8* src, u32 w, u32 h, const rsx_tex_layout* tl)
+{
+    u64 hval = 0xcbf29ce484222325ULL;
+    u8 hdr[12];
+    u32 bf = tl->base_format;
+    hdr[0] = (u8)(w);       hdr[1] = (u8)(w >> 8);
+    hdr[2] = (u8)(w >> 16); hdr[3] = (u8)(w >> 24);
+    hdr[4] = (u8)(h);       hdr[5] = (u8)(h >> 8);
+    hdr[6] = (u8)(h >> 16); hdr[7] = (u8)(h >> 24);
+    hdr[8] = (u8)(bf);      hdr[9] = (u8)(bf >> 8);
+    hdr[10] = (u8)(bf >> 16); hdr[11] = (u8)(bf >> 24);
+    hval = ui_fnv1a64(hval, hdr, sizeof hdr);
+    if (!tl->compressed && !tl->swizzled) {
+        u32 tight = w * tl->bytes_per_texel;
+        for (u32 y = 0; y < h; y++)
+            hval = ui_fnv1a64(hval, src + (size_t)y * tl->row_bytes, tight);
+    } else if (tl->compressed) {
+        u32 tight = ((w + 3u) / 4u) * tl->block_bytes;
+        for (u32 by = 0; by < tl->rows; by++)
+            hval = ui_fnv1a64(hval, src + (size_t)by * tl->row_bytes, tight);
+    } else {
+        hval = ui_fnv1a64(hval, src, tl->face_bytes);
+    }
+    return hval;
+}
+
+static void ui_decode_bc_to_rgba8(u8* dst, const u8* src, u32 w, u32 h, const rsx_tex_layout* tl)
+{
+    u32 bw = (w + 3u) / 4u;
+    u32 bh = (h + 3u) / 4u;
+    int is_bc1 = (tl->fmt == RSX_TEXFMT_BC1);
+    int is_bc2 = (tl->fmt == RSX_TEXFMT_BC2);
+    for (u32 by = 0; by < bh; by++) {
+        const u8* row_ptr = src + (size_t)by * tl->row_bytes;
+        for (u32 bx = 0; bx < bw; bx++) {
+            const u8* blk = row_ptr + (size_t)bx * tl->block_bytes;
+            const u8* cblk = is_bc1 ? blk : (blk + 8);
+            u16 c0 = (u16)(cblk[0] | (cblk[1] << 8));
+            u16 c1 = (u16)(cblk[2] | (cblk[3] << 8));
+            u32 cbits = (u32)cblk[4] | ((u32)cblk[5] << 8) | ((u32)cblk[6] << 16) | ((u32)cblk[7] << 24);
+            u8 rgb[4][4];
+            rgb[0][0] = (u8)(((c0 >> 11) & 31u) * 255u / 31u);
+            rgb[0][1] = (u8)(((c0 >> 5)  & 63u) * 255u / 63u);
+            rgb[0][2] = (u8)((c0 & 31u)         * 255u / 31u);
+            rgb[0][3] = 255u;
+            rgb[1][0] = (u8)(((c1 >> 11) & 31u) * 255u / 31u);
+            rgb[1][1] = (u8)(((c1 >> 5)  & 63u) * 255u / 63u);
+            rgb[1][2] = (u8)((c1 & 31u)         * 255u / 31u);
+            rgb[1][3] = 255u;
+            if (!is_bc1 || c0 > c1) {
+                for (int k = 0; k < 3; k++) {
+                    rgb[2][k] = (u8)((2u * rgb[0][k] + rgb[1][k]) / 3u);
+                    rgb[3][k] = (u8)((rgb[0][k] + 2u * rgb[1][k]) / 3u);
+                }
+                rgb[2][3] = 255u;
+                rgb[3][3] = 255u;
+            } else {
+                for (int k = 0; k < 3; k++) {
+                    rgb[2][k] = (u8)((rgb[0][k] + rgb[1][k]) / 2u);
+                    rgb[3][k] = 0u;
+                }
+                rgb[2][3] = 255u;
+                rgb[3][3] = 0u;
+            }
+            u8 bc3_a[8];
+            u64 bc3_bits = 0;
+            if (!is_bc1 && !is_bc2) {
+                u8 a0 = blk[0], a1 = blk[1];
+                bc3_a[0] = a0; bc3_a[1] = a1;
+                if (a0 > a1) {
+                    for (int k = 1; k <= 6; k++)
+                        bc3_a[k + 1] = (u8)(((7 - k) * (u32)a0 + k * (u32)a1) / 7u);
+                } else {
+                    for (int k = 1; k <= 4; k++)
+                        bc3_a[k + 1] = (u8)(((5 - k) * (u32)a0 + k * (u32)a1) / 5u);
+                    bc3_a[6] = 0u;
+                    bc3_a[7] = 255u;
+                }
+                for (int k = 0; k < 6; k++)
+                    bc3_bits |= ((u64)blk[2 + k]) << (8 * k);
+            }
+            for (u32 py = 0; py < 4u; py++) {
+                u32 dy = by * 4u + py;
+                if (dy >= h) continue;
+                u16 bc2_row = is_bc2 ? (u16)(blk[py * 2u] | (blk[py * 2u + 1u] << 8)) : 0u;
+                for (u32 px = 0; px < 4u; px++) {
+                    u32 dx = bx * 4u + px;
+                    if (dx >= w) continue;
+                    u32 idx = py * 4u + px;
+                    u32 ci = (cbits >> (2u * idx)) & 3u;
+                    u8 a = rgb[ci][3];
+                    if (is_bc2)
+                        a = (u8)(((bc2_row >> (4u * px)) & 0xFu) * 17u);
+                    else if (!is_bc1)
+                        a = bc3_a[(bc3_bits >> (3u * idx)) & 7u];
+                    u8* out = dst + ((size_t)dy * w + dx) * 4u;
+                    out[0] = rgb[ci][0];
+                    out[1] = rgb[ci][1];
+                    out[2] = rgb[ci][2];
+                    out[3] = a;
+                }
+            }
+        }
+    }
+}
