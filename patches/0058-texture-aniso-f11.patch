+static void toggle_fullscreen(HWND hwnd)
+{
+    if (!s_fullscreen) {
+        GetWindowRect(hwnd, &s_windowed_rect);
+        s_windowed_style = GetWindowLongPtrA(hwnd, GWL_STYLE);
+        MONITORINFO mi = {0}; mi.cbSize = sizeof mi;
+        if (!GetMonitorInfoA(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi)) return;
+        SetWindowLongPtrA(hwnd, GWL_STYLE,
+            (s_windowed_style & ~(WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX |
+                                  WS_MAXIMIZEBOX | WS_SYSMENU)) | WS_POPUP);
+        SetWindowPos(hwnd, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
+                     mi.rcMonitor.right - mi.rcMonitor.left,
+                     mi.rcMonitor.bottom - mi.rcMonitor.top,
+                     SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+        s_fullscreen = 1;
+        fprintf(stderr, "[WINDOW] F11 fullscreen on%c", 10);
+    } else {
+        SetWindowLongPtrA(hwnd, GWL_STYLE, s_windowed_style);
+        SetWindowPos(hwnd, HWND_TOP, s_windowed_rect.left, s_windowed_rect.top,
+                     s_windowed_rect.right - s_windowed_rect.left,
+                     s_windowed_rect.bottom - s_windowed_rect.top,
+                     SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+        s_fullscreen = 0;
+        fprintf(stderr, "[WINDOW] F11 fullscreen off%c", 10);
+    }
+}
 
 static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
+    /* The host overlay (save picker) is modal: it sees the message first and
+     * consumes keys/mouse while it is open, including Esc -- which otherwise
+     * closes the game in the switch below. */
