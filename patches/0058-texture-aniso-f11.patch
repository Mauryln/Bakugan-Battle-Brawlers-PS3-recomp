+        s_host_overlay.input(s_host_overlay.userdata, msg,
+                             (unsigned long long)wp, (long long)lp))
+        return 0;
+
     switch (msg) {
     case WM_CLOSE:
         s_d3d.window_closed = 1;
         DestroyWindow(hwnd);
         return 0;
     case WM_DESTROY:
         PostQuitMessage(0);
         return 0;
     case WM_KEYDOWN:
+        if (wp == VK_F11) {
+            toggle_fullscreen(hwnd);
+            return 0;
+        }
