+static int savedata_load_hidden(const char* name)
+{
+    const char* env = getenv("PS3_SAVEDATA_HIDE_LOAD");
+    if (!env || !*env) return 0;
+    const char* seg = env;
+    for (;;) {
+        const char* bar = strchr(seg, '|');
+        size_t n = bar ? (size_t)(bar - seg) : strlen(seg);
+        if (n && strlen(name) == n && !strncmp(name, seg, n)) return 1;
+        if (!bar) break;
+        seg = bar + 1;
+    }
+    return 0;
+}
