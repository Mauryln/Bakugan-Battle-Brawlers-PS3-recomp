+/* A directory that holds only the firmware metadata (PARAM.SFO/PARAM.PFD) is a
+ * stub left by an aborted first save, not something the player can load. The
+ * title still counts it when it computes the next "-NN" name, so the first real
+ * save moves to the following slot and the stub stays orphaned forever. */
+static int savedata_slot_is_stub(const char* path)
+{
+    char sfo[1024];
+    snprintf(sfo, sizeof(sfo), "%s/PARAM.SFO", path);
+    HOST_STAT_T st;
+    if (HOST_STAT(sfo, &st) != 0)
+        return 0;
+
+#ifdef _WIN32
+    char search[1024];
+    snprintf(search, sizeof(search), "%s\\*", path);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h == INVALID_HANDLE_VALUE)
+        return 0;
+    int stub = 1;
+    do {
+        if (!strcmp(fd.cFileName, ".") || !strcmp(fd.cFileName, ".."))
+            continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) { stub = 0; break; }
+        if (!savedata_system_file(fd.cFileName)) { stub = 0; break; }
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+    return stub;
+#else
+    DIR* dp = opendir(path);
+    if (!dp)
+        return 0;
+    int stub = 1;
+    struct dirent* de;
+    while ((de = readdir(dp)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, ".."))
+            continue;
+        if (savedata_system_file(de->d_name))
+            continue;
+        stub = 0;
+        break;
+    }
+    closedir(dp);
+    return stub;
+#endif
+}
+
+/* Reuse the newest stub numbered below a fresh "-NN" target. Titles name the
+ * next slot themselves after counting every existing directory, stubs
+ * included; redirecting the save keeps a first-run aborted slot usable instead
+ * of creating the next number and leaving the stub behind. */
+static int savedata_reuse_stub(const char* dir, char* out, size_t n)
+{
+    adopt_gamedata_root();
+    size_t len = strlen(dir);
+    if (len < 3 || len - 2 >= CELL_SAVEDATA_DIRNAME_SIZE - 2) return 0;
+    if (dir[len - 3] != '-' ||
+        dir[len - 2] < '0' || dir[len - 2] > '9' ||
+        dir[len - 1] < '0' || dir[len - 1] > '9') return 0;
+
+    int target = (dir[len - 2] - '0') * 10 + (dir[len - 1] - '0');
+    if (target <= 0) return 0;
+
+    char base[CELL_SAVEDATA_DIRNAME_SIZE];
+    size_t base_len = len - 2;                 /* keeps the '-' */
+    memcpy(base, dir, base_len);
+    base[base_len] = 0;
+
+    int best = -1;
+    char full[1024];
+
+#ifdef _WIN32
+    char search[1024];
+    snprintf(search, sizeof(search), "%s\\*", s_save_root);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h == INVALID_HANDLE_VALUE)
+        return 0;
+    do {
+        if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) continue;
+        const char* name = fd.cFileName;
+        if (strlen(name) != base_len + 2) continue;
+        if (strncmp(name, base, base_len) != 0) continue;
+        if (name[base_len] < '0' || name[base_len] > '9' ||
+            name[base_len + 1] < '0' || name[base_len + 1] > '9') continue;
+        int idx = (name[base_len] - '0') * 10 + (name[base_len + 1] - '0');
+        if (idx >= target || idx <= best) continue;
+        snprintf(full, sizeof(full), "%s\\%s", s_save_root, name);
+        if (savedata_slot_is_stub(full)) best = idx;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+#else
+    DIR* dp = opendir(s_save_root);
+    if (!dp)
+        return 0;
+    struct dirent* de;
+    while ((de = readdir(dp)) != NULL) {
+        const char* name = de->d_name;
+        if (strlen(name) != base_len + 2) continue;
+        if (strncmp(name, base, base_len) != 0) continue;
+        if (name[base_len] < '0' || name[base_len] > '9' ||
+            name[base_len + 1] < '0' || name[base_len + 1] > '9') continue;
+        int idx = (name[base_len] - '0') * 10 + (name[base_len + 1] - '0');
+        if (idx >= target || idx <= best) continue;
+        snprintf(full, sizeof(full), "%s/%s", s_save_root, name);
+        if (savedata_slot_is_stub(full)) best = idx;
+    }
+    closedir(dp);
+#endif
+
+    if (best < 0)
+        return 0;
+    snprintf(out, n, "%s%02d", base, best);
+    return 1;
+}
