 #define GCM_FIFO_CATCHUP_BYTES 0x10000u
+
+/* Ports with complete FIFO flip markers must not concatenate the next frame's
+ * passes while catching up. Other toolkit users retain the legacy policy. */
+static int gcm_fifo_stop_at_flip(u32 backlog)
+{
+    static int full_frames = -1;
+    if (full_frames < 0) {
+        const char* value = getenv("GCM_FULL_FRAMES");
+        full_frames = value && *value != '0';
+    }
+    return full_frames || backlog < GCM_FIFO_CATCHUP_BYTES;
+}
