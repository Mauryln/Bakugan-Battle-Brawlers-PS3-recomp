diff --git a/libs/video/rsx_pack_workers.inc b/libs/video/rsx_pack_workers.inc
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_pack_workers.inc
@@ -0,0 +1,122 @@
+/* Closed-frame upload copies only. The FIFO owner keeps all D3D12 calls and
+ * freezes source, destination, parity and capacity until the batch join. */
+#include <process.h>
+#include <emmintrin.h>
+typedef struct VPPackRun {
+    const void* src;
+    void* dst;
+    u32 count, mask;
+} VPPackRun;
+static struct {
+    SRWLOCK lock;
+    CONDITION_VARIABLE work, idle;
+    HANDLE thread[4], event;
+    VPPackRun runs[MAX_DRAWS];
+    struct { u32 first, end; } jobs[4];
+    u32 threads, next, jobs_count, pending;
+    int initialized, active, stop;
+} s_pack = {SRWLOCK_INIT, CONDITION_VARIABLE_INIT, CONDITION_VARIABLE_INIT};
+
+static unsigned __stdcall vp_pack_worker(void* unused)
+{
+    (void)unused;
+    for (;;) {
+        AcquireSRWLockExclusive(&s_pack.lock);
+        while (s_pack.next == s_pack.jobs_count && !s_pack.stop)
+            SleepConditionVariableSRW(&s_pack.work, &s_pack.lock, INFINITE, 0);
+        if (s_pack.next == s_pack.jobs_count && s_pack.stop) {
+            ReleaseSRWLockExclusive(&s_pack.lock); return 0;
+        }
+        u32 job = s_pack.next++;
+        u32 first = s_pack.jobs[job].first, end = s_pack.jobs[job].end;
+        ReleaseSRWLockExclusive(&s_pack.lock);
+        for (u32 r = first; r < end; ++r) {
+            const VPPackRun* run = &s_pack.runs[r];
+            vp_pack_vertex_stream(run->dst, run->src, run->count, run->mask);
+        }
+        /* WC stores must drain on the writer before completion is published. */
+        _mm_sfence();
+        AcquireSRWLockExclusive(&s_pack.lock);
+        if (--s_pack.pending == 0) WakeAllConditionVariable(&s_pack.idle);
+        ReleaseSRWLockExclusive(&s_pack.lock);
+    }
+}
+static void vp_pack_workers_join(void)
+{
+    if (!s_pack.initialized) return;
+    AcquireSRWLockExclusive(&s_pack.lock);
+    while (s_pack.pending)
+        SleepConditionVariableSRW(&s_pack.idle, &s_pack.lock, INFINITE, 0);
+    ReleaseSRWLockExclusive(&s_pack.lock);
+}
+static void vp_pack_workers_shutdown(void)
+{
+    vp_pack_workers_join();
+    AcquireSRWLockExclusive(&s_pack.lock);
+    s_pack.stop = 1;
+    ReleaseSRWLockExclusive(&s_pack.lock);
+    WakeAllConditionVariable(&s_pack.work);
+    for (u32 i = 0; i < s_pack.threads; ++i) {
+        WaitForSingleObject(s_pack.thread[i], INFINITE);
+        CloseHandle(s_pack.thread[i]);
+    }
+    s_pack.threads = 0; s_pack.active = 0;
+    if (s_pack.event) { CloseHandle(s_pack.event); s_pack.event = NULL; }
+}
+static int vp_pack_workers_active(void)
+{
+    if (!s_pack.initialized) {
+        s_pack.initialized = 1;
+        const char* value = getenv("RSX_PACK_WORKERS");
+        int count = value ? atoi(value) : 0;
+        if (count >= 1 && count <= 4) {
+            for (int i = 0; i < count; ++i) {
+                HANDLE h = (HANDLE)_beginthreadex(NULL, 0, vp_pack_worker, NULL, 0, NULL);
+                if (!h) { vp_pack_workers_shutdown(); return 0; }
+                s_pack.thread[s_pack.threads++] = h;
+            }
+            s_pack.active = 1;
+            const char* event = getenv("RSX_PACK_WORKERS_EVENT");
+            if (event && *event) {
+                SetLastError(ERROR_SUCCESS);
+                s_pack.event = CreateEventA(NULL, TRUE, TRUE, event);
+                DWORD error = GetLastError();
+                if (!s_pack.event || error == ERROR_ALREADY_EXISTS) {
+                    fprintf(stderr, "[PACK AB invalid] event error=%lu\n", error);
+                    vp_pack_workers_shutdown(); return 0;
+                }
+            }
+            fprintf(stderr, "[PACK] %u workers, closed staging, aligned frame batches\n", s_pack.threads);
+        }
+    }
+    if (s_pack.event) {
+        DWORD result = WaitForSingleObject(s_pack.event, 0);
+        if (result == WAIT_OBJECT_0) s_pack.active = 1;
+        else if (result == WAIT_TIMEOUT) s_pack.active = 0;
+        else { fprintf(stderr, "[PACK AB invalid] poll failed\n"); vp_pack_workers_shutdown(); }
+    }
+    return s_pack.active;
+}
+static int vp_pack_workers_begin(u32 runs, u32 bytes)
+{
+    if (!s_pack.active || !runs || bytes < 1024u * 1024u) return 0;
+    /* Partition only on 64-byte output boundaries. Adjacent workers never
+     * share a WC line; offsets and the original compact layout stay intact. */
+    u32 parts = s_pack.threads, jobs = 0, first = 0;
+    u64 done = 0, target = ((u64)bytes + parts - 1u) / parts;
+    for (u32 i = 0; i < runs; ++i) {
+        const VPPackRun* r = &s_pack.runs[i];
+        done += (u64)r->count * vp_vertex_stride(r->mask);
+        if (i + 1u < runs && jobs + 1u < parts && done >= target &&
+            !((uintptr_t)s_pack.runs[i + 1u].dst & 63u)) {
+            s_pack.jobs[jobs].first = first; s_pack.jobs[jobs++].end = i + 1u;
+            first = i + 1u; target = ((u64)bytes * (jobs + 1u) + parts - 1u) / parts;
+        }
+    }
+    s_pack.jobs[jobs].first = first; s_pack.jobs[jobs++].end = runs;
+    AcquireSRWLockExclusive(&s_pack.lock);
+    s_pack.next = 0; s_pack.jobs_count = jobs; s_pack.pending = jobs;
+    ReleaseSRWLockExclusive(&s_pack.lock);
+    WakeAllConditionVariable(&s_pack.work);
+    return 1;
+}
