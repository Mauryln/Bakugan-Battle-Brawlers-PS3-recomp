 /* The backend snapshots constants after the four texscale vectors and alpha
  * state. Use buffered translation so the instruction-only PSO key is valid. */
+static int fp_override_rgb(char* hlsl, u32 capacity)
+{
+    char* last = NULL;
+    for (char* p = strstr(hlsl, "    return "); p; p = strstr(p + 1, "    return ")) last = p;
+    if (!last) return 0;
+    char* end = strstr(last, ";\n}\n");
+    if (!end) return 0;
+    char expression[96], replacement[256];
+    size_t length = (size_t)(end - last - 11);
+    if (length >= sizeof(expression)) return 0;
+    memcpy(expression, last + 11, length); expression[length] = 0;
+    if (strstr(hlsl, "struct PSOutput"))
+        snprintf(replacement, sizeof(replacement), "    PSOutput _forced = %s;\n    _forced.t0.rgb = float3(1,0,1);\n    return _forced", expression);
+    else
+        snprintf(replacement, sizeof(replacement), "    float4 _forced = %s;\n    _forced.rgb = float3(1,0,1);\n    return _forced", expression);
+    size_t prefix = (size_t)(last - hlsl), inserted = strlen(replacement), tail = strlen(end) + 1;
+    if (prefix + inserted + tail > capacity) return 0;
+    memmove(last + inserted, end, tail);
+    memcpy(last, replacement, inserted);
+    return 1;
+}
