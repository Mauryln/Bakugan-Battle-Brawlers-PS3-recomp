+/* Native, sampleable D24 surfaces for the legacy D3D12 backend. */
+#ifndef RSX_D3D12_DEPTH_H
+#define RSX_D3D12_DEPTH_H
+
+#define MAX_DEPTH_SURFACES 16
+typedef struct {
+    ID3D12Resource* resource;
+    u32 offset, width, height;
+    D3D12_RESOURCE_STATES state;
+    int used, initialized;
+} RSXDepthSurface;
+static struct {
+    ID3D12Device* device;
+    ID3D12DescriptorHeap* dsv_heap;
+    u32 dsv_increment;
+    RSXDepthSurface surfaces[MAX_DEPTH_SURFACES];
+} s_depth_pool;
+
+static D3D12_CPU_DESCRIPTOR_HANDLE depth_pool_dsv(int slot, int readonly)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE handle;
+    s_depth_pool.dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_depth_pool.dsv_heap, &handle);
+    handle.ptr += (size_t)(1 + slot * 2 + readonly) * s_depth_pool.dsv_increment;
+    return handle;
+}
+
+static int depth_pool_find(u32 offset, u32 width, u32 height)
+{
+    for (int i = 0; i < MAX_DEPTH_SURFACES; ++i) {
+        const RSXDepthSurface* surface = &s_depth_pool.surfaces[i];
+        if (surface->resource && surface->offset == offset &&
+            surface->width == width && surface->height == height) return i;
+    }
+    return -1;
+}
+
+/* The caller has already retired the previous GPU frame. Entries referenced
+ * by this frame must be marked used before another allocation can evict them. */
+static int depth_pool_get(u32 offset, u32 width, u32 height)
+{
+    if (!offset || !width || !height || width > 4096 || height > 4096) return -1;
+    int slot = depth_pool_find(offset, width, height);
+    if (slot >= 0) { s_depth_pool.surfaces[slot].used = 1; return slot; }
+    for (int i = 0; i < MAX_DEPTH_SURFACES; ++i)
+        if (!s_depth_pool.surfaces[i].resource) { slot = i; break; }
+    if (slot < 0) for (int i = 0; i < MAX_DEPTH_SURFACES; ++i)
+        if (!s_depth_pool.surfaces[i].used) { slot = i; break; }
+    if (slot < 0) { fprintf(stderr, "[D3D12 depth] active surface pool is full\n"); return -1; }
+
+    D3D12_HEAP_PROPERTIES heap = {0}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc = {0};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width; desc.Height = height;
+    desc.DepthOrArraySize = desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R24G8_TYPELESS;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE clear = {0};
+    clear.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    clear.DepthStencil.Depth = 1.0f;
+    ID3D12Resource* resource = NULL;
+    HRESULT hr = s_depth_pool.device->lpVtbl->CreateCommittedResource(s_depth_pool.device,
+        &heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_DEPTH_WRITE, &clear,
+        &IID_ID3D12Resource, (void**)&resource);
+    if (FAILED(hr)) { fprintf(stderr, "[D3D12 depth] allocation failed %08lX\n", hr); return -1; }
+    RSXDepthSurface* surface = &s_depth_pool.surfaces[slot];
+    if (surface->resource) surface->resource->lpVtbl->Release(surface->resource);
+    memset(surface, 0, sizeof(*surface));
+    surface->resource = resource;
+    surface->offset = offset; surface->width = width; surface->height = height;
+    surface->state = D3D12_RESOURCE_STATE_DEPTH_WRITE; surface->used = 1;
+    D3D12_DEPTH_STENCIL_VIEW_DESC view = {0};
+    view.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    view.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    s_depth_pool.device->lpVtbl->CreateDepthStencilView(s_depth_pool.device,
+        resource, &view, depth_pool_dsv(slot, 0));
+    view.Flags = D3D12_DSV_FLAG_READ_ONLY_DEPTH | D3D12_DSV_FLAG_READ_ONLY_STENCIL;
+    s_depth_pool.device->lpVtbl->CreateDepthStencilView(s_depth_pool.device,
+        resource, &view, depth_pool_dsv(slot, 1));
+    fprintf(stderr, "[D3D12 depth] slot=%d zeta=%08X %ux%u\n", slot, offset, width, height);
+    return slot;
+}
+
+static void depth_pool_transition(ID3D12GraphicsCommandList* commands, int slot, D3D12_RESOURCE_STATES state)
+{
+    RSXDepthSurface* surface = &s_depth_pool.surfaces[slot];
+    D3D12_RESOURCE_BARRIER barrier = {0};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = surface->resource;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    if (!surface->initialized) {
+        /* A fresh native resource has no previous contents. Initialize once;
+         * later clears belong exclusively to the guest's ordered clear ops. */
+        commands->lpVtbl->ClearDepthStencilView(commands, depth_pool_dsv(slot, 0),
+            D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 1.0f, 0, 0, NULL);
+        surface->initialized = 1;
+    }
+    if (surface->state == state) return;
+    barrier.Transition.StateBefore = surface->state;
+    barrier.Transition.StateAfter = state;
+    commands->lpVtbl->ResourceBarrier(commands, 1, &barrier);
+    surface->state = state;
+}
+
+static void depth_pool_shutdown(void)
+{
+    for (int i = 0; i < MAX_DEPTH_SURFACES; ++i)
+        if (s_depth_pool.surfaces[i].resource)
+            s_depth_pool.surfaces[i].resource->lpVtbl->Release(s_depth_pool.surfaces[i].resource);
+    memset(&s_depth_pool, 0, sizeof(s_depth_pool));
+}
+#endif
