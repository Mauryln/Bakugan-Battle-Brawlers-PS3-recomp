+static int s_pick_cache_enabled = -1;
+
+/* Negative filter values are valid data, not an uninitialized sentinel.
+ * Keep an explicit rollback for comparisons with the original lookup path. */
+static int vp_pick_filter(void)
+{
+    static int initialized = 0, value = -2;
+    if (s_pick_cache_enabled < 0) {
+        const char* mode = getenv("RSX_PICK_CACHE");
+        s_pick_cache_enabled = !mode || atoi(mode) != 0;
+    }
+    if (!initialized || (!s_pick_cache_enabled && value < 0)) {
+        const char* e = getenv("RSX_DBG_PICK");
+        value = e ? atoi(e) : -2;
+        initialized = 1;
+    }
+    return value;
