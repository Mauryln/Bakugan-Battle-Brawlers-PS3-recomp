+static int pad_external_report(u32 port_no, ps3_host_pad_report* out)
+{
+    if (port_no >= PAD_MAX_HOST_PORTS || !s_host_provider)
+        return 0;
+    ps3_host_pad_report tmp;
+    memset(&tmp, 0, sizeof(tmp));
+    if (!s_host_provider(port_no, &tmp, s_host_provider_userdata))
+        return 0;
+    if (out)
+        *out = tmp;
+    return 1;
+}
+
+static int pad_port_connected(u32 port_no)
+{
+    if (port_no >= PAD_MAX_HOST_PORTS)
+        return 0;
+    return pad_external_report(port_no, NULL) || s_host_state[port_no].connected || port_no == 0;
+}
