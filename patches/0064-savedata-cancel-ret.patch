+/* The applet returns CELL_CANCEL (1) when the player backs out of the dialog.
+ * Reporting it as CELL_SAVEDATA_CBRESULT_ERR_NODATA made every list operation
+ * return CELL_SAVEDATA_ERROR_CBRESULT instead, which a title can mistake for a
+ * fatal profile failure (this is where the guest's exit(-1) at the main menu
+ * comes from). s_select_cancelled carries the host picker's cancel to the
+ * caller without changing the guest callback's result code. */
+#define CELL_SAVEDATA_RET_CANCEL 1
+static int s_select_cancelled;
