+
+static SRWLOCK s_video_lock = SRWLOCK_INIT;
+static u8* s_video_pixels;
+static u32 s_video_width, s_video_height;
+static ID3D12Resource* s_video_upload;
+
+void rsx_d3d12_backend_video_frame(const u8* pixels, u32 width, u32 height)
+{
+    AcquireSRWLockExclusive(&s_video_lock);
+    if (!pixels || !width || !height || width > 8192 || height > 8192) {
+        s_video_width = s_video_height = 0;
+    } else {
+        size_t size = (size_t)width * height * 4;
+        u8* copy = (u8*)realloc(s_video_pixels, size);
+        if (copy) {
+            s_video_pixels = copy;
+            memcpy(copy, pixels, size);
+            s_video_width = width; s_video_height = height;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_video_lock);
+}
+
+/* Native media presentation is independent of the guest's offscreen resolve.
+ * render_frame has already drained the GPU before reusing this upload buffer. */
+static void video_present(u32 fi)
+{
+    AcquireSRWLockShared(&s_video_lock);
+    if (!s_video_width) { ReleaseSRWLockShared(&s_video_lock); return; }
+    u32 w = s_d3d.width, h = s_d3d.height;
+    u32 pitch = (w * 4u + 255u) & ~255u;
+    if (!s_video_upload) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0}; bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = (u64)pitch * h; bd.Height = 1; bd.DepthOrArraySize = 1;
+        bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE,
+            &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_video_upload);
+    }
+    if (!s_video_upload) { ReleaseSRWLockShared(&s_video_lock); return; }
+    u8* mapped = NULL; D3D12_RANGE nr = {0,0};
+    if (FAILED(s_video_upload->lpVtbl->Map(s_video_upload, 0, &nr, (void**)&mapped))) {
+        ReleaseSRWLockShared(&s_video_lock); return;
+    }
+    u32 dw = w, dh = (u32)((u64)w * s_video_height / s_video_width);
+    if (dh > h) { dh = h; dw = (u32)((u64)h * s_video_width / s_video_height); }
+    u32 left = (w - dw) / 2, top = (h - dh) / 2;
+    memset(mapped, 0, (size_t)pitch * h);
+    for (u32 y = 0; y < dh; y++) {
+        const u8* src = s_video_pixels + (size_t)((u64)y * s_video_height / dh) * s_video_width * 4;
+        u8* dst = mapped + (size_t)(y + top) * pitch + left * 4;
+        for (u32 x = 0; x < dw; x++) {
+            const u8* px = src + (size_t)((u64)x * s_video_width / dw) * 4;
+            dst[x*4] = px[2]; dst[x*4+1] = px[1]; dst[x*4+2] = px[0]; dst[x*4+3] = 255;
+        }
+    }
+    D3D12_RANGE wr = {0,(SIZE_T)pitch*h};
+    s_video_upload->lpVtbl->Unmap(s_video_upload, 0, &wr);
+    ReleaseSRWLockShared(&s_video_lock);
+    D3D12_RESOURCE_BARRIER b = {0}; b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s_d3d.render_targets[fi];
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = s_d3d.render_targets[fi]; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = s_video_upload; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    src.PlacedFootprint.Footprint.Width = w; src.PlacedFootprint.Footprint.Height = h;
+    src.PlacedFootprint.Footprint.Depth = 1; src.PlacedFootprint.Footprint.RowPitch = pitch;
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+}
 
