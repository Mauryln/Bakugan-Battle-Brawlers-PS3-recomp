+
+/* Futures used by synchronous HLE completions. Never report an unset result as
+ * success: Bakugan tests the output word after boot and otherwise skips FMVs. */
+s32 cellSailFutureInitialize(u32 self)
+{
+    if (!self) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    for (u32 i = 0; i < 24; i += 4) vm_write32(self + i, 0);
+    return CELL_OK;
+}
+
+s32 cellSailFutureSet(u32 self, s32 result)
+{
+    if (!self) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    vm_write32(self + 12, (u32)result);
+    vm_write32(self + 8, 1);
+    return CELL_OK;
+}
+
+s32 cellSailFutureGet(u32 self, u64 timeout, u32 result)
+{
+    (void)timeout;
+    if (!self || !result) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    if (!vm_read32(self + 8)) return (s32)0x80610708; /* NOT_AVAILABLE */
+    vm_write32(result, vm_read32(self + 12));
+    return CELL_OK;
+}
+
+s32 cellSailPlayerReplaceEventHandler(u32 self, u32 callback, u32 arg,
+                                     u32 previous_callback, u32 previous_arg)
+{
+    int slot = sail_player_slot(self);
+    if (slot < 0) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    if (previous_callback) vm_write32(previous_callback, s_sail_players[slot].callback_ea);
+    if (previous_arg) vm_write32(previous_arg, s_sail_players[slot].arg_ea);
+    s_sail_players[slot].callback_ea = callback;
+    s_sail_players[slot].arg_ea = arg;
+    return CELL_OK;
+}
+
+s32 cellSailPlayerFinalize(u32 self)
+{
+    int slot = sail_player_slot(self);
+    if (slot < 0) return (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+    memset(&s_sail_players[slot], 0, sizeof(s_sail_players[slot]));
+    return CELL_OK;
+}
+
+s32 cellSailGraphicsAdapterFinalize(u32 self)
+{
+    return self ? CELL_OK : (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+}
+
+s32 cellSailSoundAdapterFinalize(u32 self)
+{
+    return self ? CELL_OK : (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
 }
 
