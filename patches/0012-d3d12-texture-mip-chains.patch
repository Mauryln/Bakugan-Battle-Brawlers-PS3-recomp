+static void vp_decode_texture_subresources(void* mapped, const u8* source,
+    const rsx_tex_level* levels, u32 level_count, u32 faces, u32 face_stride,
+    const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* footprints, int argb_as_rgba)
+{
+    for (u32 face = 0; face < faces; face++) {
+        for (u32 mip = 0; mip < level_count; mip++) {
+            const rsx_tex_level* lv = &levels[mip];
+            const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp =
+                &footprints[face * level_count + mip];
+            rsx_texture_decode((u8*)mapped + fp->Offset, fp->Footprint.RowPitch,
+                source + face * face_stride + lv->offset,
+                lv->w, lv->h, &lv->tl, argb_as_rgba);
+        }
+    }
+}
