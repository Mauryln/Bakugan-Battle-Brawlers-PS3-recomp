+/* The synthetic callback already submits a wrap JUMP and waits for it. A
+ * second recycler on the consumer can teleport GET to begin without taking
+ * that JUMP, losing commands and leaving the producer waiting two seconds. */
+static int gcm_title_recycle_allowed(u32 ctx)
+{
+    if (!ctx) return 0;
+    u32 callback = vm_read32(ctx + 0xCu);
+    if (callback == GCM_FIFO_CALLBACK_SENTINEL_EA) return 0;
+    return !callback || vm_read32(callback) != GCM_FIFO_CALLBACK_SENTINEL_EA;
+}
