+/* GL comparison enums 0x200..0x207 map to D3D comparisons 1..8.
+ * Snapshot the write mask too: a read-only portrait pass must not change the
+ * depth mask prepared by an earlier colour-disabled draw. */
+static u32 rsx_depth_key(const rsx_state* st)
+{
+    if (!st) return 1u | 2u | (1u << 2); /* enabled, LESS, writes */
+    return (st->depth_test_enable ? 1u : 0u)
+         | ((st->depth_test_enable && st->depth_mask) ? 2u : 0u)
+         | ((st->depth_func & 7u) << 2);
+}
