+static wchar_t s_fp_cache_path[MAX_PATH];
 static struct { u8* data; u32 size; int ready; } s_fpcache;
+typedef struct fp_cache_write {
+    wchar_t path[MAX_PATH];
+    u32 size;
+    u8 data[];
+} fp_cache_write;
+static struct {
+    CRITICAL_SECTION lock;
+    HANDLE wake, idle;
+    fp_cache_write* pending;
+    int started;
+} s_fp_writer;
+
+static u32 fp_cache_checksum(u64 key, const void* data, u32 size)
+{
+    const u8* bytes = data;
+    u32 hash = 2166136261u;
+    for (u32 i = 0; i < 8; i++) { hash ^= (u8)(key >> (i * 8)); hash *= 16777619u; }
+    for (u32 i = 0; i < 4; i++) { hash ^= (u8)(size >> (i * 8)); hash *= 16777619u; }
+    for (u32 i = 0; i < size; i++) { hash ^= bytes[i]; hash *= 16777619u; }
+    return hash;
+}
+
+static DWORD WINAPI fp_cache_writer(void* unused)
+{
+    (void)unused;
+    for (;;) {
+        WaitForSingleObject(s_fp_writer.wake, INFINITE);
+        EnterCriticalSection(&s_fp_writer.lock);
+        fp_cache_write* job = s_fp_writer.pending;
+        s_fp_writer.pending = NULL;
+        LeaveCriticalSection(&s_fp_writer.lock);
+        if (!job) continue;
+        wchar_t temporary[MAX_PATH + 40];
+        swprintf(temporary, MAX_PATH + 40, L"%ls.tmp.%lu", job->path,
+                 (unsigned long)GetCurrentProcessId());
+        FILE* file = _wfopen(temporary, L"wb");
+        int ok = 0;
+        if (file) {
+            ok = fwrite(job->data, 1, job->size, file) == job->size;
+            ok &= fflush(file) == 0;
+            ok &= _commit(_fileno(file)) == 0;
+            ok &= fclose(file) == 0;
+        }
+        if (!ok || !MoveFileExW(temporary, job->path,
+                MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+            fprintf(stderr, "[FP] local cache write failed (err=%lu)\n",
+                    (unsigned long)GetLastError());
+            DeleteFileW(temporary);
+        }
+        free(job);
+        EnterCriticalSection(&s_fp_writer.lock);
+        if (!s_fp_writer.pending) SetEvent(s_fp_writer.idle);
+        LeaveCriticalSection(&s_fp_writer.lock);
+    }
+}
+
+static void fp_cache_flush(void)
+{
+    if (s_fp_writer.started &&
+        WaitForSingleObject(s_fp_writer.idle, 5000) != WAIT_OBJECT_0)
+        fprintf(stderr, "[FP] local cache flush timed out; previous file retained\n");
+}
+
+void rsx_d3d12_backend_flush_shader_cache(void)
+{
+    fp_cache_flush();
+}
 
