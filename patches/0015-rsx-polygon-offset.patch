+static void rsx_polygon_offset(const rsx_state* st, int* bias, float* slope)
+{
+    *bias = 0; *slope = 0.0f;
+    if (!st || !st->polygon_offset_fill_enable) return;
+    double units = st->polygon_offset_bias;
+    if (isfinite(units)) {
+        *bias = units >= INT_MAX ? INT_MAX : units <= INT_MIN ? INT_MIN
+            : (int)round(units);
+    }
+    if (isfinite(st->polygon_offset_scale)) *slope = st->polygon_offset_scale;
+}
