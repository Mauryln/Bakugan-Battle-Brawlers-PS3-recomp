+/* D3D raster coordinates use top origin and half-pixel centers. RSX WPOS
+ * follows SET_SHADER_WINDOW; keep this dynamic in unused b1 texscale lanes. */
+static void rsx_window_transform(u32 window, float* transform)
+{
+    int bottom = ((window >> 12) & 15u) == 1u;
+    float center = ((window >> 16) & 15u) == 1u ? -0.5f : 0.0f;
+    transform[0] = bottom ? -1.0f : 1.0f;
+    transform[1] = (bottom ? (float)(window & 0xFFFu) : 0.0f) + center;
+    transform[2] = center;
+}
